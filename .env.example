# Copie este arquivo para .env e preencha os valores.

DATABASE_URL="postgresql://imoveis:imoveis@localhost:5432/imoveis?schema=public"

# Auth.js — gere um valor forte em produção, ex: `openssl rand -base64 32`
AUTH_SECRET="troque-por-um-valor-aleatorio-forte"

# Cloudflare R2 (armazenamento de mídia)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend (envio do e-mail do formulário de contato para o corretor
# responsável do imóvel ou, na falta dele, para o e-mail de Configurações)
# Crie uma conta em resend.com, verifique um domínio e gere uma API key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Site <contato@suaimobiliaria.com.br>"

# Seed do usuário administrador inicial (npx prisma db seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_SENHA="admin123"

# Multi-tenant: organização criada pelo seed (npx prisma db seed) e usada
# pelo site público até a Fase 3 (roteamento por /{orgSlug}) ser implementada.
ORG_SLUG="boccia"
ORG_NAME="Boccia Consultoria Imobiliária"
PUBLIC_ORG_SLUG="boccia"

# Marca/branding (ver src/lib/site-config.ts)
NEXT_PUBLIC_NOME_IMOBILIARIA="Imobiliária"
NEXT_PUBLIC_WHATSAPP_NUMERO=""
NEXT_PUBLIC_EMAIL_CONTATO="contato@example.com"

# URL pública do site (usada para gerar links absolutos no Open Graph/redes sociais)
NEXT_PUBLIC_SITE_URL="https://www.suaimobiliaria.com.br"
