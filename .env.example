# Copie este arquivo para .env e preencha os valores.

DATABASE_URL="postgresql://imoveis:imoveis@localhost:5432/imoveis?schema=public"

# Auth.js — gere um valor forte em produção, ex: `openssl rand -base64 32`
AUTH_SECRET="troque-por-um-valor-aleatorio-forte"

# Auth.js da área /platform (Super Admin da EasyMob) — instância separada,
# secret PRÓPRIO de propósito: rotacionar um não deve invalidar sessões do
# outro. Gere com o mesmo comando acima.
PLATFORM_AUTH_SECRET="troque-por-outro-valor-aleatorio-forte"

# Cloudflare R2 (armazenamento de mídia)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend (envio do e-mail do formulário de contato para o corretor
# responsável do imóvel ou, na falta dele, para o e-mail de Configurações)
# Crie uma conta em resend.com, verifique um domínio e gere uma API key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Site <contato@suaimobiliaria.com.br>"

# Upstash Redis (rate limiting — login, formulários públicos, upload).
# Crie uma conta gratuita em upstash.com e um banco Redis (REST API).
# Sem essas variáveis, o rate limiting fica desativado (fail-open: nada é
# bloqueado, só um aviso no console) — o resto do sistema funciona normal.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (error tracking — ver README, seção Observabilidade). Sem DSN, a
# integração fica desligada (fail-open, mesmo padrão de R2/Resend/Upstash):
# nada quebra, só não reporta nada. Crie um projeto Next.js em sentry.io.
NEXT_PUBLIC_SENTRY_DSN=""
# development | staging | production
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Identifica o release pelo commit. Em produção (DigitalOcean App
# Platform), aponte para ${_self.COMMIT_HASH} — variável embutida da
# própria plataforma, disponível em build e runtime — não digite um valor
# fixo aqui.
NEXT_PUBLIC_SENTRY_RELEASE=""

# Upload de source map + criação de release durante o build — só têm
# efeito no build real de deploy (a DigitalOcean); localmente e no CI
# (GitHub Actions) ficam vazios de propósito e o build continua igual, só
# sem enviar nada à Sentry. Gere o token em sentry.io → Organization
# Settings → Auth Tokens.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Seed do usuário administrador inicial (npx prisma db seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_SENHA="admin123"

# Bootstrap do primeiro PlatformOperator/SUPER_ADMIN (identidade separada
# de qualquer OrganizationMember — ver src/lib/platform/).
# npx tsx scripts/seed-platform-operator.ts
SEED_PLATFORM_ADMIN_EMAIL=""
SEED_PLATFORM_ADMIN_SENHA=""

# Multi-tenant: organização criada pelo seed (npx prisma db seed) e usada
# pelo site público até a Fase 3 (roteamento por /{orgSlug}) ser implementada.
ORG_SLUG="boccia"
ORG_NAME="Boccia Consultoria Imobiliária"
PUBLIC_ORG_SLUG="boccia"

# Marca/branding (ver src/lib/site-config.ts)
NEXT_PUBLIC_NOME_IMOBILIARIA="Imobiliária"
NEXT_PUBLIC_WHATSAPP_NUMERO=""
NEXT_PUBLIC_EMAIL_CONTATO="contato@example.com"

# URL pública do site (usada para gerar links absolutos no Open Graph/redes sociais)
NEXT_PUBLIC_SITE_URL="https://www.suaimobiliaria.com.br"

# Fase P.10 — Custom Domains. Ambos opcionais: sem eles, subdomínio
# easymob nunca resolve nenhum host (hostnameReservado só protege o que
# está configurado) e a tela de "Domínios" mostra um placeholder no lugar
# do destino do CNAME. Nenhum dos dois cria/altera DNS/DigitalOcean real
# — são só valores exibidos/comparados.
#
# Domínio-base sob o qual organizações podem ganhar um subdomínio
# (ex: "easymob.com.br" -> xyz.easymob.com.br). Ainda não existe um
# domínio real configurado em produção (ver README) — deixar vazio até
# que exista.
PUBLIC_ORG_SUBDOMAIN_BASE=""
# Destino exibido nas instruções de DNS do Platform Admin pra um cliente
# apontar seu CNAME (ex: "sua-app.ondigitalocean.app").
CUSTOM_DOMAIN_CNAME_TARGET=""
