// ---------- Plataforma (super-admin — schema preparado, nada implementado) ----------

enum PlatformRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  SUPER_ADMIN // único usado no MVP do painel /platform; os outros dois ficam
  // preparados no enum, sem UI de permissão diferenciada ainda.
}

model PlatformOperator {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  auditLogs PlatformAuditLog[]

  @@map("platform_operators")
}

// Auditoria de ações administrativas da PLATAFORMA (não de uma organização)
// — separada de ActivityLog de propósito: ActivityLog exige organizationId
// obrigatório (é tenant-scoped), mas ações como "criei um novo operador da
// plataforma" não têm organização nenhuma associada. Ver plano em
// /Users/alexboccia/.claude/plans/glittery-noodling-harp.md, decisão #5.
// Deliberadamente FORA de TENANT_SCOPED_MODELS (src/lib/prisma.ts) — é
// consultada de forma cross-tenant por natureza.
model PlatformAuditLog {
  id                 String           @id @default(cuid())
  platformOperatorId String
  platformOperator   PlatformOperator @relation(fields: [platformOperatorId], references: [id])
  action             String // "ORGANIZATION_CREATED", "PLAN_CHANGED", "PLATFORM_OPERATOR_CREATED"...
  entity             String // "Organization", "PlatformOperator", "Plan"...
  entityId           String?
  organizationId     String? // solto, sem relation — só pra filtro (Organization não é tenant-scoped)
  metadata           Json? // nunca senha/token/cookie/secret/connection string
  createdAt          DateTime         @default(now())

  @@index([platformOperatorId, createdAt])
  @@index([entity, entityId])
  @@index([organizationId, createdAt])
  @@map("platform_audit_logs")
}

// Token de convite pro primeiro OWNER definir a própria senha — o Super
// Admin nunca define nem vê a senha permanente do cliente. Ver plano,
// decisão #6. Deliberadamente FORA de TENANT_SCOPED_MODELS: o lookup no
// momento de aceitar o convite é só por tokenHash, sem contexto de tenant
// estabelecido ainda (usuário nem logou).
// =====================================================================
// Convite de acesso a uma organização (Fase 25)
// =====================================================================
// Era OwnerInviteToken: existia só para o primeiro OWNER criado pelo
// Platform Admin. O mecanismo, porém, nunca teve nada de "owner" — é
// "esta pessoa foi convidada para esta organização e prova isso com um
// segredo de uso único". Renomear foi a alternativa a duplicar uma
// tabela de forma idêntica só para os demais papéis, o que criaria duas
// páginas de aceitação e duas semânticas para o mesmo fato.
//
// O papel do convidado NÃO mora aqui: mora no OrganizationMember
// (status INVITED). O token prova identidade, não autorização.
//
// FORA de TENANT_SCOPED_MODELS de propósito: é consumido pela página
// pública de aceitação, ANTES de existir qualquer contexto de tenant —
// o usuário nem logou ainda. Mesmo racional de OrganizationDomain.
model InviteToken {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // sha256 completo (64 hex) do token bruto — o token bruto NUNCA é
  // persistido. @unique é o índice de consulta E a garantia de que dois
  // convites não colidem.
  tokenHash      String       @unique
  expiresAt      DateTime
  // Consumo de uso único. Preenchido por updateMany com guarda
  // `usedAt: null` dentro de transaction — nunca por leitura seguida de
  // escrita, que deixaria janela de replay.
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@map("invite_tokens")
}

// =====================================================================
// Recuperação de senha (Fase 25)
// =====================================================================
// SEPARADO de InviteToken de propósito, e não por economia de tabela.
// A diferença não é de forma, é de domínio:
//
//   convite  = AUTORIZAÇÃO. Pertence a uma organização, ativa um
//              vínculo, e só faz sentido dentro dela.
//   reset    = AUTENTICAÇÃO. A senha é do User, global, atravessa
//              organizações. Um reset NÃO pertence a organização
//              nenhuma.
//
// Fundir os dois obrigaria organizationId a ser nulo em metade das
// linhas e convidaria alguém, um dia, a escopar um reset por tenant —
// que é exatamente confundir autenticação com autorização.
//
// Redefinir a senha NUNCA reativa vínculo: um membro suspenso que
// recupera a senha continua sem conseguir entrar naquela organização
// (auth.ts exige membership ACTIVE), e isso está certo — ele pode ter
// acesso legítimo a OUTRA organização com a mesma identidade.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// =====================================================================
// Fase P.10 — Custom Domains & Tenant Branding
// =====================================================================

enum OrganizationDomainType {
  EASYMOB_SUBDOMAIN
  CUSTOM
}

// PENDING: cadastrado no Platform Admin, DNS ainda não confirmado.
// VERIFIED: Platform Operator confirmou (manualmente, V1) que o DNS
// aponta pra plataforma — ainda não necessariamente com o passo manual
// de custom domain/certificado da DigitalOcean concluído (ver P.10.4).
// ACTIVE: fluxo completo — é o único status, junto com VERIFIED, que o
// tenant resolver (src/proxy.ts) aceita como tenant válido (nunca
// PENDING/FAILED/DISABLED, ver src/lib/platform/hostname.ts).
// FAILED: verificação tentada e não confirmada — nunca resolve tráfego.
// DISABLED: desativado manualmente (ex: cliente trocou de domínio) sem
// apagar o histórico — nunca resolve tráfego, mas preserva o registro.
enum OrganizationDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
  DISABLED
}

// Domínio(s) associado(s) a uma Organization — mecanismo real da Fase
// P.10, substitui conceitualmente Organization.customDomain (mantido
// intacto e não lido, ver comentário no model Organization). hostname é
// sempre normalizado (src/lib/platform/hostname.ts: normalizarHostname —
// lowercase, sem protocolo/porta/path/query/trailing dot) antes de
// gravar aqui, e é ÚNICO GLOBALMENTE: nunca duas organizações reivindicam
// o mesmo hostname, seja EASYMOB_SUBDOMAIN ou CUSTOM (mesma tabela pros
// dois tipos — decisão da Fase P.10 — evita duplicar a lógica de
// resolução/unicidade em dois lugares).
//
// Deliberadamente FORA de TENANT_SCOPED_MODELS (src/lib/prisma.ts) — MESMO
// motivo de InviteToken: é resolvido pelo proxy (src/proxy.ts) A
// PARTIR do hostname da requisição, ANTES de qualquer contexto de tenant
// existir (é o próprio dado que estabelece qual é o tenant).

// =====================================================================
// Captação pública com identidade ambígua (Fase 24)
// =====================================================================
// O PROBLEMA: o dedupe público casa Person por e-mail OU por telefone.
// Quando o e-mail bate numa Person e o telefone bate em OUTRA, não há
// como saber quem é o visitante — e escolher qualquer uma seria
// inventar identidade. Até aqui a resposta era não gravar nada: o lead
// sumia do CRM e o visitante recebia "enviado com sucesso".
//
// A recusa em escolher está certa. A perda do fato comercial não.
//
// ESTE MODELO É UM FATO DE CAPTAÇÃO, NÃO UMA TERCEIRA IDENTIDADE.
// Deliberadamente NÃO é uma Person: criar uma Person aqui produziria um
// cadastro falso, com emailNormalized/phoneNormalized forçosamente
// nulos (os valores pertencem às duas Person existentes), portanto
// eternamente não-deduplicável — e contaminaria Clientes, Analytics,
// matching e o próprio dedupe. Também não é uma Interaction: aquela
// exige personId, que é justamente o que não sabemos.
//
// CANDIDATOS NÃO SÃO PERSISTIDOS. Guardar candidateEmailPersonId /
// candidatePhonePersonId congelaria um palpite: entre a captação e a
// resolução a Person pode ser editada, ter e-mail/telefone trocados ou
// ser desativada, e o id salvo passaria a apontar para algo que já não
// casa. Os candidatos são recalculados na hora de resolver, pelo MESMO
// caminho que a captação usou — sempre atuais, nunca obsoletos.

// Estado de uma captação pública cuja identidade ficou ambígua
// (Fase 24). Só dois estados, de propósito: DISMISSED não foi criado
// porque não há caso de uso comprovado, e um estado de descarte convida
// a apagar lead real em silêncio — exatamente o dano que esta fase
// existe para eliminar. Ver dívida registrada no relatório.
enum LeadCaptureStatus {
  PENDING
  RESOLVED
}

model LeadCapture {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // O que o visitante enviou, exatamente como enviou. É PII e só é
  // exposto a quem pode resolver (ver PAPEIS_RESOLUCAO_IDENTIDADE).
  name    String
  email   String?
  phone   String?
  // Mensagem do contato, ou a descrição do imóvel em /anuncie.
  message String?

  // Derivados NO SERVIDOR na captação, nunca do formulário: `origin`
  // vem do imóvel já validado contra o tenant, e `role` distingue o
  // visitante que procura imóvel (LEAD) do proprietário que quer
  // anunciar (OWNER).
  origin String
  role   PersonRole

  // Imóvel já validado contra esta organização na captação. SET NULL:
  // se o imóvel for removido, a captação continua existindo — o
  // contato aconteceu de qualquer forma.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // Atribuição first-party (Fase 7) — preservada para que a Interaction
  // criada na resolução nasça com a mesma origem de tráfego do envio.
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  referrerHost String?

  // QUANDO O VISITANTE ENVIOU. É este instante que vai para
  // Interaction.occurredAt na resolução — um contato de segunda-feira
  // não pode virar quarta-feira no Analytics porque o gestor resolveu
  // na quarta.
  occurredAt DateTime @default(now())

  status LeadCaptureStatus @default(PENDING)

  resolvedAt DateTime?
  // Quem RESOLVEU. Ator, nunca dono nem autor: a Interaction resultante
  // continua com memberId null (Fase 15), e ninguém vira
  // responsibleMemberId por resolver (Fase 11). SET NULL como todo ator.
  resolvedByMemberId String?
  resolvedByMember   OrganizationMember? @relation("LeadCaptureResolvedByMember", fields: [resolvedByMemberId], references: [id], onDelete: SetNull)
  // Person escolhida. SET NULL (padrão de relação opcional, confirmado
  // na migration): apagar um cliente é operação ordinária de CRM e não
  // pode ser bloqueada por uma captação antiga. A captação continua
  // RESOLVED, com resolvedAt e o registro no ActivityLog — o que se
  // perde é só o ponteiro, junto com a Person que ele apontava.
  resolvedPersonId String?
  resolvedPerson   Person? @relation("LeadCaptureResolvedPerson", fields: [resolvedPersonId], references: [id])
  // @unique é a GARANTIA ESTRUTURAL de que uma captação produz no
  // máximo uma Interaction: mesmo sob duas resoluções simultâneas, o
  // banco recusa a segunda. Se a Interaction for apagada depois, este
  // campo volta a null (SET NULL) — mas `status` continua RESOLVED, que
  // é o que a guarda de resolução consulta: a captação não reabre.
  resolvedInteractionId String?      @unique
  resolvedInteraction   Interaction? @relation("LeadCaptureResolvedInteraction", fields: [resolvedInteractionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A fila operacional é exatamente (organização, status, mais antigo
  // primeiro) — este índice é o padrão de acesso, não intuição.
  @@index([organizationId, status, occurredAt])
  @@map("lead_captures")
}

model OrganizationDomain {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  hostname          String                   @unique
  type              OrganizationDomainType
  status            OrganizationDomainStatus @default(PENDING)
  // Não usado por nenhuma verificação automática nesta fase (V1 é manual,
  // ver P.10.3.3) — gerado e guardado como base pronta pra uma futura
  // verificação por DNS TXT, sem precisar de migration nova depois.
  verificationToken String                   @unique
  verifiedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId])
  @@map("organization_domains")
}

enum OrganizationEmailDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

// Remetente TRANSACIONAL próprio por Organization (Resend) — nunca uma
// caixa de e-mail hospedada pelo easymob (ver P.10.6, decisão explícita:
// sem Gmail/Workspace nesta fase). src/lib/email.ts usa isto como
// override do remetente quando status=ACTIVE; em qualquer outro status,
// cai no remetente global (RESEND_FROM_EMAIL) — nunca quebra envio
// existente (fallback obrigatório, ver P.10.6.4).
//
// Um por Organization (organizationId é a própria PK, mesmo padrão de
// OrganizationSettings/OrganizationBranding). Deliberadamente FORA de
// TENANT_SCOPED_MODELS pelo mesmo racional de OrganizationDomain: os
// call sites (enviarEmailContato/enviarEmailConviteOwner) sempre recebem
// organizationId explícito, então não há necessidade nem garantia de
// contexto de tenant ambiente no momento do envio.
//
// V1: nenhuma chamada real à API de domínio do Resend — a chave atual é
// escopada "somente envio" (resend.domains.list() retorna 401
// restricted_api_key, ver src/lib/health.ts) — status é sempre setado
// manualmente pelo Platform Operator, exatamente como OrganizationDomain.
model OrganizationEmailDomain {
  organizationId String                        @id
  organization   Organization                  @relation(fields: [organizationId], references: [id])
  domain         String                        @unique
  fromName       String
  fromAddress    String                        @unique
  status         OrganizationEmailDomainStatus @default(PENDING)
  verifiedAt     DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@map("organization_email_domains")
}
