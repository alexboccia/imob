// Schema do sistema imobiliário — ver PRD.md (seção 9) para o modelo de dados de alto nível.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ConstructionStage {
  PRE_CONSTRUCTION
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum PropertyPurpose {
  SALE
  RENT
  SALE_AND_RENT
}

enum PropertyTypeCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum MediaType {
  PHOTO
  VIDEO
  FLOOR_PLAN
}

enum PersonRole {
  LEAD
  CLIENT
  OWNER
}

enum LeadSource {
  WEBSITE
  REFERRAL
  PORTAL
  INSTAGRAM
  WHATSAPP
  OTHER
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  VISIT_SCHEDULED
  PROPOSAL
  CLOSED
  LOST
}

enum DealType {
  SALE
  LEASE
}

enum FeatureCategory {
  PROPERTY
  CONDO
}

enum InteractionType {
  VISIT
  CALL
  MESSAGE
  EMAIL
  OTHER
}

// ---------- Modelos de domínio ----------

model Person {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  taxId          String?
  roles          PersonRole[]
  source         LeadSource?
  pipelineStage  PipelineStage @default(NEW_LEAD)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignedMemberId String?
  assignedMember    OrganizationMember? @relation("PersonAssignedMember", fields: [assignedMemberId], references: [id])

  ownedProperties Property[]    @relation("PropertyOwner")
  interactions    Interaction[]
  deals           DealPerson[]

  @@index([organizationId])
  @@map("people")
}

model Property {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  code           Int             @default(autoincrement())
  title          String
  description    String?
  type           String
  purpose        PropertyPurpose
  status         PropertyStatus  @default(DRAFT)
  isLaunch       Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  isOpportunity  Boolean         @default(false)
  hasSlideshow   Boolean         @default(false)
  constructionStage ConstructionStage?
  deliveryForecast  DateTime?
  developer         String?

  // Endereço
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String
  city         String
  state        String
  latitude     Float?
  longitude    Float?

  // Valores
  price       Decimal? @db.Decimal(14, 2)
  rentPrice   Decimal? @db.Decimal(14, 2)
  condoFee    Decimal? @db.Decimal(14, 2)
  propertyTax Decimal? @db.Decimal(14, 2)

  // Características
  totalArea        Float?
  privateArea      Float?
  bedrooms         Int?
  suites           Int?
  bathrooms        Int?
  parkingSpots     Int?
  propertyFeatures String[] @default([])
  condoFeatures    String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  responsibleMemberId String?
  responsibleMember   OrganizationMember? @relation("PropertyResponsibleMember", fields: [responsibleMemberId], references: [id])

  ownerId String?
  owner   Person? @relation("PropertyOwner", fields: [ownerId], references: [id])

  media          Media[]
  statusHistory  PropertyStatusHistory[]
  interactions   Interaction[]
  deals          Deal[]
  portalListings PortalListing[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, city, neighborhood])
  @@index([organizationId, purpose, type])
  @@index([organizationId, isLaunch])
  @@map("properties")
}

model Media {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type    MediaType
  url     String
  isCover Boolean   @default(false)
  order   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@map("media")
}

model PropertyStatusHistory {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  previousStatus PropertyStatus?
  newStatus      PropertyStatus
  changedAt      DateTime        @default(now())

  @@index([propertyId])
  @@map("property_status_history")
}

model Interaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  personId       String
  person         Person              @relation(fields: [personId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?           @relation(fields: [propertyId], references: [id])
  memberId       String?
  member         OrganizationMember? @relation("InteractionMember", fields: [memberId], references: [id])

  type       InteractionType
  notes      String?
  occurredAt DateTime        @default(now())

  @@index([personId])
  @@map("interactions")
}

model Deal {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property            @relation(fields: [propertyId], references: [id])
  memberId       String?
  member         OrganizationMember? @relation("DealMember", fields: [memberId], references: [id])

  type       DealType
  finalValue Decimal  @db.Decimal(14, 2)
  commission Decimal? @db.Decimal(14, 2)
  closedAt   DateTime @default(now())

  people DealPerson[]

  @@index([propertyId])
  @@map("deals")
}

model DealPerson {
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id])

  @@id([dealId, personId])
  @@map("deal_people")
}

// Registro de envio/sincronização de um imóvel para um portal externo (ZAP, VivaReal, OLX, Imovelweb, Mercado Livre).
model PortalListing {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  propertyId         String
  property           Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  portal             String
  externalListingId  String?
  lastSyncedAt       DateTime?
  lastError          String?

  @@unique([propertyId, portal])
  @@map("portal_listings")
}

// Catálogo de opções selecionáveis para as características do imóvel/condomínio (gerenciado em /admin/caracteristicas).
model FeatureOption {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  category       FeatureCategory
  createdAt      DateTime        @default(now())

  @@unique([organizationId, category, name])
  @@map("feature_options")
}

// Catálogo de tipos de imóvel selecionáveis, residencial/comercial (gerenciado em /admin/tipos-imovel).
model PropertyTypeOption {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  category       PropertyTypeCategory
  createdAt      DateTime             @default(now())

  @@unique([organizationId, category, name])
  @@map("property_type_options")
}

// =====================================================================
// Fundação multi-tenant (EasyMob) — ver /Users/alexboccia/.claude/plans/
// glittery-noodling-harp.md para o plano completo.
// =====================================================================

// ---------- Tenancy & RBAC ----------

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  BROKER
  ASSISTANT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMember[]

  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  whatsapp       String?
  contactEmail   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  notificationPreferences NotificationPreference[]
  responsibleProperties   Property[]    @relation("PropertyResponsibleMember")
  assignedPeople          Person[]      @relation("PersonAssignedMember")
  interactions            Interaction[] @relation("InteractionMember")
  deals                   Deal[]        @relation("DealMember")

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Organization {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  customDomain   String?  @unique
  planId         String
  plan           Plan     @relation(fields: [planId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members             OrganizationMember[]
  settings             OrganizationSettings?
  subscriptions         Subscription[]
  invoices              Invoice[]
  billingEvents         BillingEvent[]
  activityLogs          ActivityLog[]
  notifications         Notification[]
  aiUsages              AiUsage[]
  people                Person[]
  properties            Property[]
  media                 Media[]
  propertyStatusHistory PropertyStatusHistory[]
  interactions          Interaction[]
  deals                 Deal[]
  portalListings        PortalListing[]
  featureOptions        FeatureOption[]
  propertyTypeOptions   PropertyTypeOption[]

  @@map("organizations")
}

model OrganizationSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  phone              String?
  email              String?
  whatsapp           String?
  instagram          String?
  facebook           String?
  youtube            String?
  linkedin           String?
  propertyCodePrefix String?
  logoUrl            String?
  logoHeight         Int?
  updatedAt          DateTime     @updatedAt

  @@map("organization_settings")
}

// ---------- Permissões (RBAC preparado, não hardcoded) ----------

model Permission {
  id          String @id @default(cuid())
  code        String @unique // "properties.create", "crm.view", "billing.manage"...
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(cuid())
  role         OrganizationRole
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ---------- Planos & Entitlements ----------

model Module {
  id          String  @id @default(cuid())
  code        String  @unique // "core","crm","properties","ia","portais","whatsapp","email"...
  name        String
  description String?
  active      Boolean @default(true)

  planModules PlanModule[]

  @@map("modules")
}

model Plan {
  id                String  @id @default(cuid())
  code              String  @unique // "BASICO" | "PRO" | "PREMIUM"
  name              String
  priceMonthlyCents Int?
  active            Boolean @default(true)

  organizations Organization[]
  planModules   PlanModule[]
  planLimits    PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanModule {
  id       String  @id @default(cuid())
  planId   String
  plan     Plan    @relation(fields: [planId], references: [id])
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id])
  enabled  Boolean @default(true)
  config   Json?

  @@unique([planId, moduleId])
  @@map("plan_modules")
}

model PlanLimit {
  id      String @id @default(cuid())
  planId  String
  plan    Plan   @relation(fields: [planId], references: [id])
  feature String // "PROPERTIES","USERS","PHOTOS","VIDEOS","IA_CREDITS"... string livre, não enum
  limit   Int?   // null = ilimitado

  @@unique([planId, feature])
  @@map("plan_limits")
}

// ---------- Billing (modelagem, zero lógica de cobrança) ----------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  externalId         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  status         InvoiceStatus
  amountCents    Int
  currency       String        @default("BRL")
  dueDate        DateTime?
  paidAt         DateTime?
  externalId     String?
  createdAt      DateTime      @default(now())

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amountCents Int
  method      String?
  status      PaymentStatus
  externalId  String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@map("payments")
}

model BillingEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  payload        Json?
  createdAt      DateTime     @default(now())

  @@map("billing_events")
}

// ---------- Auditoria ----------

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  entity         String
  entityId       String?
  action         String
  payload        Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
  @@map("activity_logs")
}

// ---------- Notificações (arquitetura, sem envio implementado) ----------

model NotificationChannel {
  id   String @id @default(cuid())
  code String @unique // "EMAIL","PUSH","WHATSAPP","SMS"
  name String

  preferences NotificationPreference[]

  @@map("notification_channels")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  type           String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@map("notifications")
}

model NotificationPreference {
  id                   String               @id @default(cuid())
  organizationMemberId String
  organizationMember   OrganizationMember   @relation(fields: [organizationMemberId], references: [id])
  channelId            String
  channel              NotificationChannel  @relation(fields: [channelId], references: [id])
  notificationType     String
  enabled              Boolean              @default(true)

  @@unique([organizationMemberId, channelId, notificationType])
  @@map("notification_preferences")
}

// ---------- Uso de IA ----------

model AiUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  provider       String
  model          String
  feature        String
  tokensInput    Int
  tokensOutput   Int
  costCents      Int?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("ai_usages")
}

// ---------- Plataforma (super-admin — schema preparado, nada implementado) ----------

enum PlatformRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

model PlatformOperator {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("platform_operators")
}
