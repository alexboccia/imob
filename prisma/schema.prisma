// ---------- Plataforma (super-admin — schema preparado, nada implementado) ----------

enum PlatformRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  SUPER_ADMIN // único usado no MVP do painel /platform; os outros dois ficam
  // preparados no enum, sem UI de permissão diferenciada ainda.
}

model PlatformOperator {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  auditLogs PlatformAuditLog[]

  @@map("platform_operators")
}

// Auditoria de ações administrativas da PLATAFORMA (não de uma organização)
// — separada de ActivityLog de propósito: ActivityLog exige organizationId
// obrigatório (é tenant-scoped), mas ações como "criei um novo operador da
// plataforma" não têm organização nenhuma associada. Ver plano em
// /Users/alexboccia/.claude/plans/glittery-noodling-harp.md, decisão #5.
// Deliberadamente FORA de TENANT_SCOPED_MODELS (src/lib/prisma.ts) — é
// consultada de forma cross-tenant por natureza.
model PlatformAuditLog {
  id                 String           @id @default(cuid())
  platformOperatorId String
  platformOperator   PlatformOperator @relation(fields: [platformOperatorId], references: [id])
  action             String // "ORGANIZATION_CREATED", "PLAN_CHANGED", "PLATFORM_OPERATOR_CREATED"...
  entity             String // "Organization", "PlatformOperator", "Plan"...
  entityId           String?
  organizationId     String? // solto, sem relation — só pra filtro (Organization não é tenant-scoped)
  metadata           Json? // nunca senha/token/cookie/secret/connection string
  createdAt          DateTime         @default(now())

  @@index([platformOperatorId, createdAt])
  @@index([entity, entityId])
  @@index([organizationId, createdAt])
  @@map("platform_audit_logs")
}

// Token de convite pro primeiro OWNER definir a própria senha — o Super
// Admin nunca define nem vê a senha permanente do cliente. Ver plano,
// decisão #6. Deliberadamente FORA de TENANT_SCOPED_MODELS: o lookup no
// momento de aceitar o convite é só por tokenHash, sem contexto de tenant
// estabelecido ainda (usuário nem logou).
model OwnerInviteToken {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tokenHash      String       @unique // sha256 completo (64 hex) do token bruto — o token bruto NUNCA é persistido
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@map("owner_invite_tokens")
}

// =====================================================================
// Fase P.10 — Custom Domains & Tenant Branding
// =====================================================================

enum OrganizationDomainType {
  EASYMOB_SUBDOMAIN
  CUSTOM
}

// PENDING: cadastrado no Platform Admin, DNS ainda não confirmado.
// VERIFIED: Platform Operator confirmou (manualmente, V1) que o DNS
// aponta pra plataforma — ainda não necessariamente com o passo manual
// de custom domain/certificado da DigitalOcean concluído (ver P.10.4).
// ACTIVE: fluxo completo — é o único status, junto com VERIFIED, que o
// tenant resolver (src/proxy.ts) aceita como tenant válido (nunca
// PENDING/FAILED/DISABLED, ver src/lib/platform/hostname.ts).
// FAILED: verificação tentada e não confirmada — nunca resolve tráfego.
// DISABLED: desativado manualmente (ex: cliente trocou de domínio) sem
// apagar o histórico — nunca resolve tráfego, mas preserva o registro.
enum OrganizationDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
  DISABLED
}

// Domínio(s) associado(s) a uma Organization — mecanismo real da Fase
// P.10, substitui conceitualmente Organization.customDomain (mantido
// intacto e não lido, ver comentário no model Organization). hostname é
// sempre normalizado (src/lib/platform/hostname.ts: normalizarHostname —
// lowercase, sem protocolo/porta/path/query/trailing dot) antes de
// gravar aqui, e é ÚNICO GLOBALMENTE: nunca duas organizações reivindicam
// o mesmo hostname, seja EASYMOB_SUBDOMAIN ou CUSTOM (mesma tabela pros
// dois tipos — decisão da Fase P.10 — evita duplicar a lógica de
// resolução/unicidade em dois lugares).
//
// Deliberadamente FORA de TENANT_SCOPED_MODELS (src/lib/prisma.ts) — MESMO
// motivo de OwnerInviteToken: é resolvido pelo proxy (src/proxy.ts) A
// PARTIR do hostname da requisição, ANTES de qualquer contexto de tenant
// existir (é o próprio dado que estabelece qual é o tenant).
model OrganizationDomain {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  hostname          String                   @unique
  type              OrganizationDomainType
  status            OrganizationDomainStatus @default(PENDING)
  // Não usado por nenhuma verificação automática nesta fase (V1 é manual,
  // ver P.10.3.3) — gerado e guardado como base pronta pra uma futura
  // verificação por DNS TXT, sem precisar de migration nova depois.
  verificationToken String                   @unique
  verifiedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId])
  @@map("organization_domains")
}

enum OrganizationEmailDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

// Remetente TRANSACIONAL próprio por Organization (Resend) — nunca uma
// caixa de e-mail hospedada pelo easymob (ver P.10.6, decisão explícita:
// sem Gmail/Workspace nesta fase). src/lib/email.ts usa isto como
// override do remetente quando status=ACTIVE; em qualquer outro status,
// cai no remetente global (RESEND_FROM_EMAIL) — nunca quebra envio
// existente (fallback obrigatório, ver P.10.6.4).
//
// Um por Organization (organizationId é a própria PK, mesmo padrão de
// OrganizationSettings/OrganizationBranding). Deliberadamente FORA de
// TENANT_SCOPED_MODELS pelo mesmo racional de OrganizationDomain: os
// call sites (enviarEmailContato/enviarEmailConviteOwner) sempre recebem
// organizationId explícito, então não há necessidade nem garantia de
// contexto de tenant ambiente no momento do envio.
//
// V1: nenhuma chamada real à API de domínio do Resend — a chave atual é
// escopada "somente envio" (resend.domains.list() retorna 401
// restricted_api_key, ver src/lib/health.ts) — status é sempre setado
// manualmente pelo Platform Operator, exatamente como OrganizationDomain.
model OrganizationEmailDomain {
  organizationId String                        @id
  organization   Organization                  @relation(fields: [organizationId], references: [id])
  domain         String                        @unique
  fromName       String
  fromAddress    String                        @unique
  status         OrganizationEmailDomainStatus @default(PENDING)
  verifiedAt     DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@map("organization_email_domains")
}
