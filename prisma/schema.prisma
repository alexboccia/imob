// Schema do sistema imobiliário — ver PRD.md (seção 9) para o modelo de dados de alto nível.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ConstructionStage {
  PRE_CONSTRUCTION
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum PropertyPurpose {
  SALE
  RENT
  SALE_AND_RENT
}

enum PropertyTypeCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum MediaType {
  PHOTO
  VIDEO
  FLOOR_PLAN
}

enum PersonRole {
  LEAD
  CLIENT
  OWNER
}

enum LeadSource {
  WEBSITE
  REFERRAL
  PORTAL
  INSTAGRAM
  WHATSAPP
  OTHER
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  VISIT_SCHEDULED
  PROPOSAL
  CLOSED
  LOST
}

enum DealType {
  SALE
  LEASE
}

enum FeatureCategory {
  PROPERTY
  CONDO
}

enum InteractionType {
  VISIT
  CALL
  MESSAGE
  EMAIL
  OTHER
}

// Estágio do relacionamento Person↔Property (Fase D do CRM). Deliberadamente
// SEM FAVORITED/RECOMMENDED/NEGOTIATING/CLOSED — ver PropertyInterest.favorited
// (dimensão independente) e o comentário do model abaixo. Nenhuma transição é
// validada nesta fase (mesmo nível de simplicidade já usado em
// Person.pipelineStage — atualizarEstagioFunil também aceita qualquer valor).
//
// WON (Fase P.2): a negociação ESPECÍFICA deste PropertyInterest foi ganha —
// nunca inferido automaticamente a partir de Property.status (SOLD/RENTED),
// porque um imóvel pode ter múltiplos PropertyInterest concorrentes (ver
// auditoria P.1, seção 31/34). Nesta fase é só fundação de schema: nenhuma
// Server Action define WON ainda (isso é P.3), e o Select manual de stage
// (atualizarEstagioInteresseSchema) deliberadamente NÃO oferece esse valor —
// ver comentário em src/lib/property-interest-schema.ts.
enum PropertyInterestStage {
  INTERESTED
  VISIT_SCHEDULED
  VISITED
  PROPOSAL
  REJECTED
  WON
}

// Agenda de atividades futuras (Fase H do CRM) — deliberadamente SEPARADA de
// Interaction: Interaction é histórico do que JÁ aconteceu, ScheduledActivity
// é o que está agendado para acontecer. V1 só agenda VISIT; o enum
// ScheduledActivityType já é genérico para tipos futuros (FOLLOW_UP, CALL...)
// sem exigir migration de schema quando chegarem, só de dado.
enum ScheduledActivityType {
  VISIT
}

enum ScheduledActivityStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ---------- Modelos de domínio ----------

model Person {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  taxId          String?
  roles          PersonRole[]
  source         LeadSource?
  pipelineStage  PipelineStage @default(NEW_LEAD)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Deduplicação de leads públicos (Fase B do CRM) — só pra achar Person
  // já existente na mesma organização, nunca exibidos/editáveis
  // diretamente. NULL de propósito quando o valor colide com outra Person
  // já existente na mesma organização (duplicata histórica pré-migration,
  // ou Person criada durante um conflito de identidade — ver
  // src/lib/person-dedup.ts) — nesses casos a Person correspondente
  // simplesmente não participa da deduplicação automática, nunca se
  // escolhe arbitrariamente qual das duas "vence" o valor normalizado.
  emailNormalized String?
  phoneNormalized String?

  assignedMemberId String?
  assignedMember   OrganizationMember? @relation("PersonAssignedMember", fields: [assignedMemberId], references: [id])

  ownedProperties     Property[]          @relation("PropertyOwner")
  interactions        Interaction[]
  deals               DealPerson[]
  preference          PersonPreference?
  propertyInterests   PropertyInterest[]
  scheduledActivities ScheduledActivity[]

  @@unique([organizationId, emailNormalized])
  @@unique([organizationId, phoneNormalized])
  @@index([organizationId])
  // GIN: `roles` é filtrado com `has`/`hasSome` (ex: dashboard, roles: {
  // has: "LEAD" }) — índice B-tree comum não serve pra containment de
  // array, só GIN.
  @@index([roles], type: Gin)
  @@map("people")
}

// Perfil de busca estruturado (Fase C do CRM) — V1: no máximo UMA
// preferência ativa por Person, por isso personId é a própria chave
// primária (mesmo padrão de OrganizationSettings/OrganizationBranding
// pra relação 1:1 — mais forte que @@unique, é garantia estrutural do
// banco). organizationId é redundante em relação a person.organizationId
// de propósito: todo model tenant-scoped deste projeto carrega sua
// própria coluna de organizationId (nunca só via join), e aqui isso é
// ainda mais importante porque não existe FK composta (personId,
// organizationId) — o isolamento cross-tenant desta tabela depende
// inteiramente da checagem em nível de aplicação (ver
// salvarPreferenciaPessoa em src/app/app/clientes/actions.ts), mesmo
// padrão já usado por registrarInteracao.
model PersonPreference {
  personId       String       @id
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Reaproveita PropertyPurpose (Property.purpose) — mesmo vocabulário,
  // sem enum irmão. SALE_AND_RENT existe no enum por causa de Property,
  // mas a UI de preferência só oferece SALE/RENT como opção selecionável
  // (não faz sentido produto uma pessoa "querer comprar E alugar" ao
  // mesmo tempo) — a validação em person-preference-schema.ts reforça
  // isso, não é só uma escolha de UI.
  transactionType PropertyPurpose?

  // Mesmo vocabulário livre de Property.type (catálogo PropertyTypeOption
  // por organização, não é enum).
  propertyTypes String[] @default([])
  // Mesmo vocabulário livre de Property.city/Property.neighborhood (texto
  // livre, sem tabela City/Neighborhood — nem aqui nem em Property).
  cities        String[] @default([])
  neighborhoods String[] @default([])

  // Mesmo tipo de Property.price/Property.rentPrice — evita mismatch
  // Decimal-vs-Float no matching futuro.
  minPrice Decimal? @db.Decimal(14, 2)
  maxPrice Decimal? @db.Decimal(14, 2)

  minBedrooms     Int?
  minBathrooms    Int?
  minParkingSpots Int?

  // V1: representa preferência sobre Property.privateArea especificamente
  // (não totalArea) — mesmo tipo Float da coluna real. Se um dia precisar
  // também de preferência por área total, é campo novo, não reaproveitar
  // este.
  minArea Float?
  maxArea Float?

  // Espelha a separação real de Property (propertyFeatures/condoFeatures,
  // dois catálogos/categorias distintos em FeatureOption) — matching
  // futuro compara cada array contra o campo correspondente do imóvel,
  // sem precisar decidir a categoria de cada string em tempo de match.
  desiredPropertyFeatures String[] @default([])
  desiredCondoFeatures    String[] @default([])

  // Observações específicas do que a pessoa procura no imóvel — nunca
  // confundir com Person.notes (observações gerais sobre a pessoa).
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("person_preferences")
}

model Property {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  code              Int                @default(autoincrement())
  title             String
  description       String?
  type              String
  purpose           PropertyPurpose
  status            PropertyStatus     @default(DRAFT)
  isLaunch          Boolean            @default(false)
  isFeatured        Boolean            @default(false)
  isOpportunity     Boolean            @default(false)
  hasSlideshow      Boolean            @default(false)
  constructionStage ConstructionStage?
  deliveryForecast  DateTime?
  developer         String?

  // Endereço
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String
  city         String
  state        String
  latitude     Float?
  longitude    Float?

  // Valores
  price       Decimal? @db.Decimal(14, 2)
  rentPrice   Decimal? @db.Decimal(14, 2)
  condoFee    Decimal? @db.Decimal(14, 2)
  propertyTax Decimal? @db.Decimal(14, 2)

  // Características
  totalArea        Float?
  privateArea      Float?
  bedrooms         Int?
  suites           Int?
  bathrooms        Int?
  parkingSpots     Int?
  propertyFeatures String[] @default([])
  condoFeatures    String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  responsibleMemberId String?
  responsibleMember   OrganizationMember? @relation("PropertyResponsibleMember", fields: [responsibleMemberId], references: [id])

  ownerId String?
  owner   Person? @relation("PropertyOwner", fields: [ownerId], references: [id])

  media               Media[]
  statusHistory       PropertyStatusHistory[]
  interactions        Interaction[]
  analyticsEvents     PropertyAnalyticsEvent[]
  deals               Deal[]
  portalListings      PortalListing[]
  interests           PropertyInterest[]
  scheduledActivities ScheduledActivity[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, city, neighborhood])
  @@index([organizationId, purpose, type])
  @@index([organizationId, isLaunch])
  // GIN: propertyFeatures/condoFeatures são filtrados com `hasSome` na
  // busca pública (src/app/[orgSlug]/imoveis/page.tsx) e no cálculo de
  // facetas (filtros-imoveis-data.ts) — mesma justificativa do índice de
  // Person.roles acima.
  @@index([propertyFeatures], type: Gin)
  @@index([condoFeatures], type: Gin)
  @@map("properties")
}

model Media {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type    MediaType
  url     String
  isCover Boolean   @default(false)
  order   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@map("media")
}

model PropertyStatusHistory {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  previousStatus PropertyStatus?
  newStatus      PropertyStatus
  changedAt      DateTime        @default(now())

  @@index([propertyId])
  @@map("property_status_history")
}

model Interaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  personId       String
  person         Person              @relation(fields: [personId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?           @relation(fields: [propertyId], references: [id])
  memberId       String?
  member         OrganizationMember? @relation("InteractionMember", fields: [memberId], references: [id])

  type       InteractionType
  notes      String?
  occurredAt DateTime        @default(now())

  // De onde veio o contato quando ele nasceu no site público: página do
  // imóvel, página de contato ou "anuncie seu imóvel" (catálogo em
  // código, ver src/lib/captacao.ts). String e não enum pelo mesmo
  // motivo do themeId: origens novas não devem exigir migration.
  //
  // Nullable e sem default de propósito: interação registrada à mão pelo
  // corretor no painel não tem origem de site, e as que já existiam
  // continuam null — nenhuma delas ganha uma origem inventada
  // retroativamente.
  origin     String?

  @@index([personId])
  @@map("interactions")
}

// Estado ATUAL do relacionamento entre uma Person e um Property (Fase D do
// CRM) — nunca histórico. Histórico de eventos reais continua em Interaction
// (CALL/MESSAGE/EMAIL/VISIT/OTHER), sem nenhuma criação automática de
// Interaction a partir de mudanças aqui (decisão explícita: alterar stage ou
// favorited não gera Interaction — só ActivityLog).
//
// id próprio (não personId como PK, diferente de PersonPreference): a
// relação aqui é N:N — uma Person pode se interessar por vários Property, um
// Property pode interessar várias Person. A unicidade real é o PAR
// (organizationId, personId, propertyId), garantida pelo @@unique abaixo,
// nunca pela PK.
// Evento digital do site público sobre um imóvel (Fase 6) — a fonte de
// verdade das etapas VISUALIZAÇÃO e INTENÇÃO do funil. Catálogo de tipos
// e placements em código: src/lib/analytics-eventos.ts.
//
// Não guarda: IP, User-Agent, e-mail, telefone, nome, nem qualquer
// fingerprint de device. O único identificador é `visitorHash`, que já
// chega derivado e ESCOPADO por (visitante, organização, imóvel) — ver a
// justificativa completa em calcularVisitorHash.
//
// NÃO existe evento de "contato enviado" aqui de propósito: essa etapa
// continua sendo Interaction (origin ∈ ORIGENS_CAPTACAO), fonte única,
// sem dupla contagem. Ver cabeçalho de analytics-eventos.ts.
model PropertyAnalyticsEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Obrigatório: os dois eventos desta fase são, por definição, sobre um
  // imóvel específico. Um "view" sem imóvel não significaria nada.
  //
  // Cascade (não Restrict, não SetNull): telemetria É conteúdo do imóvel,
  // mesmo grupo de Media/PropertyStatusHistory/PortalListing, e não uma
  // relação de negócio como PropertyInterest/Deal. Restrict tornaria um
  // imóvel indeletável assim que recebesse a primeira visualização —
  // inaceitável. Consequência assumida: apagar um imóvel apaga o
  // histórico digital dele, e totais de períodos passados mudam. Na
  // prática o caminho normal do produto é status INACTIVE, não DELETE.
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // String validada por catálogo, não enum do Postgres — mesmo motivo de
  // Interaction.origin: tipo de evento novo não deve exigir migration.
  type String

  // Só faz sentido para WHATSAPP_CLICK (qual dos três CTAs). Null para
  // PROPERTY_VIEW. Coluna validada por catálogo em vez de JSON livre,
  // pra continuar sendo consultável e de cardinalidade fechada.
  placement String?

  // sha256(visitorId : organizationId : propertyId), 32 hex. Pseudônimo e
  // escopado: o mesmo visitante em outro imóvel produz um hash sem
  // relação computável com este.
  visitorHash String

  occurredAt DateTime @default(now())

  // Índices derivados das DUAS queries reais que existem, não
  // especulativos:
  //   (1) agregações do dashboard — sempre organizationId + faixa de
  //       occurredAt, agrupando por type e/ou propertyId em memória;
  //   (2) deduplicação na escrita — organizationId + propertyId + type +
  //       visitorHash + occurredAt >= corte.
  @@index([organizationId, occurredAt])
  @@index([organizationId, propertyId, type, visitorHash, occurredAt])
  @@map("property_analytics_events")
}

model PropertyInterest {
  id             String       @id @default(cuid())
  // Sem onDelete explícito: relação obrigatória (String, não String?) sem
  // anotação já resolve pra RESTRICT por padrão no Prisma — mesmo
  // comportamento (silencioso) de Person.organizationId/Property.organizationId
  // em todo o schema. Organização nunca pode ser apagada com PropertyInterest
  // pendurado nela.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // RESTRICT (padrão implícito, relação obrigatória sem anotação — não
  // Cascade, não SetNull): diferente de Interaction.propertyId (opcional,
  // sobrevive à exclusão do imóvel porque uma Interaction pode ser um
  // contato genérico sem imóvel nenhum, e por isso é SET NULL), PropertyInterest
  // É sobre um imóvel específico — sem propertyId o registro perde todo o
  // sentido. Segue o mesmo precedente de Deal.propertyId (RESTRICT), não o
  // de Media/PropertyStatusHistory/PortalListing (CASCADE, que são conteúdo
  // do imóvel, não uma relação de negócio).
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  stage     PropertyInterestStage @default(INTERESTED)
  // Dimensão independente do stage — um cliente pode favoritar em qualquer
  // estágio, e desfavoritar não é uma "regressão" de funil. Nunca combinar
  // num único enum com stage (ver comentário de PropertyInterestStage).
  favorited Boolean               @default(false)

  notes String?

  // Momento real de encerramento como ganho ou perdido (Fase P.2) — nunca
  // confundir com updatedAt, que muda em QUALQUER escrita (stage, favorited
  // ou notes) e por isso não serve como "data de fechamento" (auditoria
  // P.1, seção 27). Nullable, sem default: fundação de schema apenas —
  // nenhum código desta fase escreve neste campo (permanece null pra todo
  // registro existente e novo até a P.3 criar a action de fechamento que o
  // preenche atomicamente junto da mudança de stage).
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledActivities ScheduledActivity[]
  stageHistory        PropertyInterestStageHistory[]

  // @@unique([organizationId, personId, propertyId]) já serve, por prefixo
  // esquerdo, tanto consultas só por organizationId quanto por
  // (organizationId, personId) — índices próprios pra esses dois casos
  // seriam redundantes. propertyId é a terceira coluna da unique (não
  // prefixo), por isso o índice (organizationId, propertyId) continua
  // sendo o único jeito de servir a ficha do imóvel eficientemente.
  @@unique([organizationId, personId, propertyId])
  @@index([organizationId, propertyId])
  @@map("property_interests")
}

// Trilha temporal de mudanças de PropertyInterest.stage (Fase P.6) — mesmo
// papel de PropertyStatusHistory pra Property.status, mesma convenção de
// nomes (previousX/newX, changedAt @default(now())): fato estruturado e
// consultável, nunca substitui `stage` (única fonte do estado atual) nem
// ActivityLog (auditoria/evento de aplicação, payload solto, não indexado
// pra range de data por stage). Zero PII aqui de propósito — nada de nome,
// email, telefone, notes ou título de imóvel.
//
// previousStage nullable: a primeira transição registrada de um
// PropertyInterest não tem "de onde" antes dela — nunca inventado/inferido
// pra registros anteriores a esta fase (migration é só estrutural, sem
// backfill; ausência de histórico = aging indisponível, nunca uma origem
// fake). newStage obrigatório: toda linha representa uma transição que de
// fato aconteceu, gravada na MESMA transação que a mudança de stage.
model PropertyInterestStageHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propertyInterestId String
  propertyInterest   PropertyInterest @relation(fields: [propertyInterestId], references: [id], onDelete: Cascade)

  previousStage PropertyInterestStage?
  newStage      PropertyInterestStage

  changedAt DateTime @default(now())

  // Serve exatamente a query "última transição por PropertyInterest" (Kanban
  // aberto, batched via include aninhado — mesmo padrão de
  // scheduledActivities). Nenhum índice adicional: não há consulta
  // planejada de "todo histórico da organização por data" nesta fase.
  @@index([organizationId, propertyInterestId, changedAt])
  @@map("property_interest_stage_history")
}

// Agenda de atividades futuras vinculadas a uma Person (Fase H do CRM) —
// nunca reaproveita Interaction como agenda: Interaction é histórico do que
// já ocorreu, ScheduledActivity é o que está marcado pra ocorrer. V1 só cria
// type=VISIT (ver ScheduledActivityType). completedAt/cancelledAt registram
// quando o status mudou de SCHEDULED — nunca ambos preenchidos ao mesmo
// tempo, mas isso não é validado em nível de banco nesta fase (mesmo nível
// de simplicidade de PropertyInterestStage/Person.pipelineStage: nenhuma
// transição de status é validada no schema).
model ScheduledActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  propertyInterestId String?
  propertyInterest   PropertyInterest? @relation(fields: [propertyInterestId], references: [id])

  createdByMemberId String?
  createdByMember   OrganizationMember? @relation("ScheduledActivityCreatedByMember", fields: [createdByMemberId], references: [id])

  type   ScheduledActivityType   @default(VISIT)
  status ScheduledActivityStatus @default(SCHEDULED)

  scheduledAt DateTime
  completedAt DateTime?
  cancelledAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, personId, scheduledAt])
  @@index([organizationId, propertyId, scheduledAt])
  @@index([organizationId, propertyInterestId, scheduledAt])
  @@index([organizationId, status, scheduledAt])
  @@map("scheduled_activities")
}

model Deal {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property            @relation(fields: [propertyId], references: [id])
  memberId       String?
  member         OrganizationMember? @relation("DealMember", fields: [memberId], references: [id])

  type       DealType
  finalValue Decimal  @db.Decimal(14, 2)
  commission Decimal? @db.Decimal(14, 2)
  closedAt   DateTime @default(now())

  people DealPerson[]

  @@index([propertyId])
  @@map("deals")
}

model DealPerson {
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id])

  @@id([dealId, personId])
  @@map("deal_people")
}

// Registro de envio/sincronização de um imóvel para um portal externo (ZAP, VivaReal, OLX, Imovelweb, Mercado Livre).
model PortalListing {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  propertyId        String
  property          Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  portal            String
  externalListingId String?
  lastSyncedAt      DateTime?
  lastError         String?

  @@unique([propertyId, portal])
  @@map("portal_listings")
}

// Catálogo de opções selecionáveis para as características do imóvel/condomínio (gerenciado em /admin/caracteristicas).
model FeatureOption {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  category       FeatureCategory
  createdAt      DateTime        @default(now())

  @@unique([organizationId, category, name])
  @@map("feature_options")
}

// Catálogo de tipos de imóvel selecionáveis, residencial/comercial (gerenciado em /admin/tipos-imovel).
model PropertyTypeOption {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  category       PropertyTypeCategory
  createdAt      DateTime             @default(now())

  @@unique([organizationId, category, name])
  @@map("property_type_options")
}

// =====================================================================
// Fundação multi-tenant (EasyMob) — ver /Users/alexboccia/.claude/plans/
// glittery-noodling-harp.md para o plano completo.
// =====================================================================

// ---------- Tenancy & RBAC ----------

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  BROKER
  ASSISTANT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       OrganizationMember[]
  ownerInviteTokens OwnerInviteToken[]

  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  // Contatos OPERACIONAIS do membro (uso interno/administrativo): é o
  // número que a equipe usa entre si e nas ferramentas do painel. Não são
  // dados de publicação — ver os campos public* abaixo, que existem
  // justamente porque um número cadastrado pra trabalhar não é
  // consentimento pra aparecer no site.
  whatsapp       String?
  contactEmail   String?

  // ---------- Identidade comercial pública do profissional ----------
  // Separada da identidade interna (User.name/avatarUrl, que existem pro
  // painel e são globais ao User, atravessando organizações). Estes
  // campos vivem no VÍNCULO porque a identidade profissional é com a
  // imobiliária: o mesmo User pode atuar em duas organizações com CRECI,
  // foto e apresentação diferentes — e autorizado a aparecer em uma sem
  // estar em outra.
  //
  // publicProfileEnabled é o ÚNICO portão de publicação e nasce false:
  // nenhum membro existente passa a aparecer no site por causa desta
  // migration, e papel (OWNER/ADMIN), ser responsável por um imóvel, ter
  // WhatsApp ou ter avatar NÃO implicam publicação. Desligar a flag para
  // de publicar sem apagar nada — dá pra preparar o perfil antes e
  // despublicar depois sem perder o conteúdo.
  publicProfileEnabled Boolean @default(false)
  publicCreci          String?
  publicPhotoUrl       String?
  publicBio            String?
  // WhatsApp declarado PARA o site, separado do operacional acima. Sem
  // ele o CTA do imóvel cai no número institucional da organização — o
  // número de trabalho do membro nunca é publicado por conveniência.
  publicWhatsapp       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationPreferences    NotificationPreference[]
  responsibleProperties      Property[]               @relation("PropertyResponsibleMember")
  assignedPeople             Person[]                 @relation("PersonAssignedMember")
  interactions               Interaction[]            @relation("InteractionMember")
  deals                      Deal[]                   @relation("DealMember")
  createdScheduledActivities ScheduledActivity[]      @relation("ScheduledActivityCreatedByMember")

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Organization {
  id           String   @id @default(cuid())
  slug         String   @unique
  // Vestigial (Fase 2 do multi-tenant original) — nunca lido por nenhum
  // código de aplicação (confirmado por grep antes da Fase P.10). Fase
  // P.10 introduz OrganizationDomain (múltiplos domínios, status,
  // verificação) como o mecanismo real; esta coluna fica intocada
  // (migration aditiva-only, nunca DROP) até uma fase futura confirmar
  // que está seguro removê-la.
  customDomain String?  @unique
  name         String
  cnpj         String?
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Fase P.9: preço mensal CONTRATADO desta organização, quando diverge do
  // padrão do plano (plan.priceMonthlyCents) — null = usa o padrão do
  // plano. Nunca sobrescreve plan.priceMonthlyCents; resolvido junto com
  // os limites efetivos em resolverEntitlementsOrganizacao.
  priceMonthlyCentsOverride Int?

  members                      OrganizationMember[]
  limitOverrides               OrganizationLimitOverride[]
  settings                     OrganizationSettings?
  branding                     OrganizationBranding?
  subscriptions                Subscription[]
  invoices                     Invoice[]
  billingEvents                BillingEvent[]
  activityLogs                 ActivityLog[]
  notifications                Notification[]
  aiUsages                     AiUsage[]
  people                       Person[]
  personPreferences            PersonPreference[]
  propertyInterests            PropertyInterest[]
  propertyInterestStageHistory PropertyInterestStageHistory[]
  scheduledActivities          ScheduledActivity[]
  properties                   Property[]
  media                        Media[]
  propertyStatusHistory        PropertyStatusHistory[]
  interactions                 Interaction[]
  analyticsEvents              PropertyAnalyticsEvent[]
  deals                        Deal[]
  portalListings               PortalListing[]
  featureOptions               FeatureOption[]
  propertyTypeOptions          PropertyTypeOption[]
  ownerInviteTokens            OwnerInviteToken[]
  domains                      OrganizationDomain[]
  emailDomain                  OrganizationEmailDomain?

  @@map("organizations")
}

model OrganizationSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  phone              String?
  email              String?
  whatsapp           String?
  instagram          String?
  facebook           String?
  youtube            String?
  linkedin           String?
  propertyCodePrefix String?
  logoUrl            String?
  logoHeight         Int?
  // Logotipo dedicado ao rodapé do site público (fundo pode ser escuro —
  // ver OrganizationBranding.footerAppearance) — mesmo asset de sempre
  // (R2, upload por /api/admin/upload), só um segundo slot, opcional. Sem
  // isto, o rodapé cai no MESMO logoUrl do cabeçalho (ver SiteFooter.tsx).
  footerLogoUrl      String?
  // Altura (px) do logotipo no rodapé — equivalente a logoHeight, mas
  // independente: o rodapé costuma pedir um tamanho diferente do
  // cabeçalho (fundo escuro, versão alternativa do logo). null = altura
  // padrão do rodapé (ver LOGO_RODAPE_ALTURA_PADRAO em src/lib/logo.ts),
  // que é exatamente o tamanho fixo que o rodapé usava antes deste campo
  // existir — nenhum tenant muda de aparência por não ter configurado.
  footerLogoHeight   Int?
  // Imagem de fundo do Hero da Home pública (site/[orgSlug]/page.tsx) —
  // mesmo asset de sempre (R2, upload por /api/admin/upload, pasta
  // "hero", sempre reprocessada/recodificada, ver hero-image-processar.ts).
  // null (nenhum tenant enviou ainda, ou "Restaurar imagem padrão") cai
  // no fallback estático do produto (IMAGEM_HERO_PADRAO, site-config.ts)
  // — a Home nunca fica sem Hero.
  heroImageUrl       String?
  updatedAt          DateTime     @updatedAt

  @@map("organization_settings")
}

// Tema visual do site público — só a escolha (themeId aponta pro catálogo
// fixo em código, ver src/lib/branding/temas.ts) e o favicon. Logo
// continua vindo só de OrganizationSettings.logoUrl (não duplicar). A
// ausência desta linha é um estado válido: resolverTema() trata como
// "classic-blue" — nenhum tenant existente quebra por não ter branding
// configurado.
//
// Fase P.10: displayName é o ÚNICO campo novo aqui. Cores (primary/
// secondary/accent) foram deliberadamente NÃO adicionadas como hex livre
// — o catálogo de temas (CATALOGO_TEMAS, src/lib/branding/temas.ts) já
// resolve exatamente o problema que P.10.5.3 descreve (evitar CSS/cor
// arbitrária vinda do banco), e é mais seguro: zero superfície de
// injeção, sem precisar de validação Zod de hex. Duplicar com campos hex
// soltos reabriria o risco que o catálogo existe pra fechar. Ver
// relatório da Fase P.10, item "branding" — decisão documentada.
//
// customTheme (abaixo) NÃO reabre esse risco: nunca é texto livre vindo
// de um input do usuário — é sempre o JSON gerado deterministicamente a
// partir do logotipo (src/lib/branding/gerar-paleta.ts), nunca aceito
// vindo do client (nem no "gerar" nem no "aplicar", ver
// aplicarPaletaGerada em configuracoes/actions.ts), e revalidado
// estritamente por tokensTemaSchema (7 chaves fixas, cada uma
// "oklch(L C H)") toda vez que é lido de volta — mesmo shape/rigor do
// catálogo fixo, só que gerado em vez de escrito à mão.
model OrganizationBranding {
  organizationId   String       @id
  organization     Organization @relation(fields: [organizationId], references: [id])
  displayName      String?
  themeId          String       @default("classic-blue")
  faviconUrl       String?
  // Aparência do rodapé público — mesmo racional de themeId acima:
  // catálogo FIXO em código ("AUTO" | "PRIMARY" | "LIGHT", ver
  // src/lib/branding/aparencia-rodape.ts), nunca cor/CSS livre vinda do
  // banco. "AUTO" (variação escura derivada do tema via color-mix, sem
  // precisar de um token novo por tema) é o padrão — mesmo visual que o
  // rodapé já tinha antes deste campo existir, nenhum tenant existente
  // muda de aparência só por essa migration.
  footerAppearance String       @default("AUTO")
  // Tema gerado automaticamente a partir do logotipo (ver comentário
  // acima do model) — só é lido quando themeId = "custom"
  // (THEME_ID_CUSTOMIZADO, temas.ts). null enquanto ninguém gerou/aplicou
  // uma paleta ainda; nenhum tenant existente é afetado por este campo
  // (themeId continua "classic-blue" por padrão).
  customTheme      Json?
  updatedAt        DateTime     @updatedAt

  @@map("organization_branding")
}

// ---------- Permissões (RBAC preparado, não hardcoded) ----------

model Permission {
  id          String @id @default(cuid())
  code        String @unique // "properties.create", "crm.view", "billing.manage"...
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(cuid())
  role         OrganizationRole
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ---------- Planos & Entitlements ----------

model Module {
  id          String  @id @default(cuid())
  code        String  @unique // "core","crm","properties","ia","portais","whatsapp","email"...
  name        String
  description String?
  active      Boolean @default(true)

  planModules PlanModule[]

  @@map("modules")
}

// Fase P.9: isTrial/trialDays são metadados do PLANO (duração padrão de
// trial quando uma Organization é criada neste plano) — NUNCA o período
// real de trial de uma organização específica, que vive em Subscription
// (status TRIALING + currentPeriodStart/End, ver resolverEstadoAcessoOrganizacao
// em src/lib/entitlements.ts). Isso permite extensão individual de trial
// sem alterar o padrão do plano, e evita uma segunda fonte de verdade.
model Plan {
  id                String  @id @default(cuid())
  code              String  @unique // "STARTER" | "BASICO" | "PRO" | "PREMIUM"
  name              String
  priceMonthlyCents Int?
  active            Boolean @default(true)
  isTrial           Boolean @default(false)
  trialDays         Int?

  organizations Organization[]
  planModules   PlanModule[]
  planLimits    PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanModule {
  id       String  @id @default(cuid())
  planId   String
  plan     Plan    @relation(fields: [planId], references: [id])
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id])
  enabled  Boolean @default(true)
  config   Json?

  @@unique([planId, moduleId])
  @@map("plan_modules")
}

model PlanLimit {
  id      String @id @default(cuid())
  planId  String
  plan    Plan   @relation(fields: [planId], references: [id])
  feature String // "PROPERTIES","USERS","PHOTOS","VIDEOS","IA_CREDITS"... string livre, não enum
  limit   Int? // null = ilimitado

  @@unique([planId, feature])
  @@map("plan_limits")
}

// Fase P.9: exceção comercial POR ORGANIZAÇÃO — mesma forma de PlanLimit
// de propósito (feature livre, limit nullable), pra cobrir qualquer limite
// existente ou futuro sem migration nova. Semântica crítica, nunca
// confundir: AUSÊNCIA de linha (organizationId, feature) = "sem override,
// herda PlanLimit do plano atual"; PRESENÇA de linha com limit=null =
// "override explícito para ilimitado". As duas situações são
// estruturalmente distinguíveis (findUnique retorna null vs retorna uma
// linha com campo null) — resolverLimiteEfetivo (src/lib/entitlements.ts)
// nunca usa `??` direto sobre o resultado da consulta, exatamente pra não
// confundir as duas. Sem planId: independe de qual plano a organização
// está — sobrevive intacto a qualquer troca de plano (alterarPlano nunca
// toca aqui).
model OrganizationLimitOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  feature        String
  limit          Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, feature])
  @@map("organization_limit_overrides")
}

// ---------- Billing (modelagem, zero lógica de cobrança) ----------

