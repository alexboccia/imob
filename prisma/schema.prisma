// Schema do sistema imobiliário — ver PRD.md (seção 9) para o modelo de dados de alto nível.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ConstructionStage {
  PRE_CONSTRUCTION
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum PropertyPurpose {
  SALE
  RENT
  SALE_AND_RENT
}

enum PropertyTypeCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum MediaType {
  PHOTO
  VIDEO
  FLOOR_PLAN
}

enum PersonRole {
  LEAD
  CLIENT
  OWNER
}

enum LeadSource {
  WEBSITE
  REFERRAL
  PORTAL
  INSTAGRAM
  WHATSAPP
  OTHER
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  VISIT_SCHEDULED
  PROPOSAL
  CLOSED
  LOST
}

enum DealType {
  SALE
  LEASE
}

enum FeatureCategory {
  PROPERTY
  CONDO
}

enum InteractionType {
  VISIT
  CALL
  MESSAGE
  EMAIL
  OTHER
}

// Estágio do relacionamento Person↔Property (Fase D do CRM). Deliberadamente
// SEM FAVORITED/RECOMMENDED/NEGOTIATING/CLOSED — ver PropertyInterest.favorited
// (dimensão independente) e o comentário do model abaixo. Nenhuma transição é
// validada nesta fase (mesmo nível de simplicidade já usado em
// Person.pipelineStage — atualizarEstagioFunil também aceita qualquer valor).
//
// WON (Fase P.2): a negociação ESPECÍFICA deste PropertyInterest foi ganha —
// nunca inferido automaticamente a partir de Property.status (SOLD/RENTED),
// porque um imóvel pode ter múltiplos PropertyInterest concorrentes (ver
// auditoria P.1, seção 31/34). Nesta fase é só fundação de schema: nenhuma
// Server Action define WON ainda (isso é P.3), e o Select manual de stage
// (atualizarEstagioInteresseSchema) deliberadamente NÃO oferece esse valor —
// ver comentário em src/lib/property-interest-schema.ts.
enum PropertyInterestStage {
  INTERESTED
  VISIT_SCHEDULED
  VISITED
  PROPOSAL
  REJECTED
  WON
}

// Agenda de atividades futuras (Fase H do CRM) — deliberadamente SEPARADA de
// Interaction: Interaction é histórico do que JÁ aconteceu, ScheduledActivity
// é o que está agendado para acontecer. V1 só agenda VISIT; o enum
// ScheduledActivityType já é genérico para tipos futuros (FOLLOW_UP, CALL...)
// sem exigir migration de schema quando chegarem, só de dado.
// Tipo do COMPROMISSO COMERCIAL agendado (Fase 19).
//
// A auditoria confirmou o que a H.1/H.2 já tinha desenhado: este model é
// uma entidade GENÉRICA de compromisso que até aqui só tinha um tipo. O
// discriminador `type` existe desde a H.1 com @default(VISIT), os índices
// são todos type-agnósticos, e as regras específicas de visita
// (propertyId obrigatório, imóvel AVAILABLE, avanço de stage) sempre
// viveram na CAMADA DE APLICAÇÃO, nunca no schema. Por isso a Fase 19
// evolui este enum em vez de criar uma segunda agenda.
//
// FOLLOW_UP é deliberadamente UM tipo genérico com assunto textual
// (`subject`), e não uma taxonomia CALL/EMAIL/DOCUMENT/PROPOSAL: não há
// evidência de uso real que sustente essa taxonomia, e um enum
// especulativo engessaria o produto. "Enviar proposta revisada" é mais
// informativo do que qualquer rótulo que pudéssemos ter adivinhado.
enum ScheduledActivityType {
  VISIT
  FOLLOW_UP
}

enum ScheduledActivityStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ---------- Modelos de domínio ----------

model Person {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  taxId          String?
  roles          PersonRole[]
  source         LeadSource?
  pipelineStage  PipelineStage @default(NEW_LEAD)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Deduplicação de leads públicos (Fase B do CRM) — só pra achar Person
  // já existente na mesma organização, nunca exibidos/editáveis
  // diretamente. NULL de propósito quando o valor colide com outra Person
  // já existente na mesma organização (duplicata histórica pré-migration,
  // ou Person criada durante um conflito de identidade — ver
  // src/lib/person-dedup.ts) — nesses casos a Person correspondente
  // simplesmente não participa da deduplicação automática, nunca se
  // escolhe arbitrariamente qual das duas "vence" o valor normalizado.
  emailNormalized String?
  phoneNormalized String?

  assignedMemberId String?
  assignedMember   OrganizationMember? @relation("PersonAssignedMember", fields: [assignedMemberId], references: [id])

  ownedProperties     Property[]          @relation("PropertyOwner")
  interactions        Interaction[]
  leadCapturesResolvidas LeadCapture[]    @relation("LeadCaptureResolvedPerson")
  deals               DealPerson[]
  preference          PersonPreference?
  propertyInterests   PropertyInterest[]
  scheduledActivities ScheduledActivity[]

  @@unique([organizationId, emailNormalized])
  @@unique([organizationId, phoneNormalized])
  @@index([organizationId])
  // GIN: `roles` é filtrado com `has`/`hasSome` (ex: dashboard, roles: {
  // has: "LEAD" }) — índice B-tree comum não serve pra containment de
  // array, só GIN.
  @@index([roles], type: Gin)
  @@map("people")
}

// Perfil de busca estruturado (Fase C do CRM) — V1: no máximo UMA
// preferência ativa por Person, por isso personId é a própria chave
// primária (mesmo padrão de OrganizationSettings/OrganizationBranding
// pra relação 1:1 — mais forte que @@unique, é garantia estrutural do
// banco). organizationId é redundante em relação a person.organizationId
// de propósito: todo model tenant-scoped deste projeto carrega sua
// própria coluna de organizationId (nunca só via join), e aqui isso é
// ainda mais importante porque não existe FK composta (personId,
// organizationId) — o isolamento cross-tenant desta tabela depende
// inteiramente da checagem em nível de aplicação (ver
// salvarPreferenciaPessoa em src/app/app/clientes/actions.ts), mesmo
// padrão já usado por registrarInteracao.
model PersonPreference {
  personId       String       @id
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Reaproveita PropertyPurpose (Property.purpose) — mesmo vocabulário,
  // sem enum irmão. SALE_AND_RENT existe no enum por causa de Property,
  // mas a UI de preferência só oferece SALE/RENT como opção selecionável
  // (não faz sentido produto uma pessoa "querer comprar E alugar" ao
  // mesmo tempo) — a validação em person-preference-schema.ts reforça
  // isso, não é só uma escolha de UI.
  transactionType PropertyPurpose?

  // Mesmo vocabulário livre de Property.type (catálogo PropertyTypeOption
  // por organização, não é enum).
  propertyTypes String[] @default([])
  // Mesmo vocabulário livre de Property.city/Property.neighborhood (texto
  // livre, sem tabela City/Neighborhood — nem aqui nem em Property).
  cities        String[] @default([])
  neighborhoods String[] @default([])

  // Mesmo tipo de Property.price/Property.rentPrice — evita mismatch
  // Decimal-vs-Float no matching futuro.
  minPrice Decimal? @db.Decimal(14, 2)
  maxPrice Decimal? @db.Decimal(14, 2)

  minBedrooms     Int?
  minBathrooms    Int?
  minParkingSpots Int?

  // V1: representa preferência sobre Property.privateArea especificamente
  // (não totalArea) — mesmo tipo Float da coluna real. Se um dia precisar
  // também de preferência por área total, é campo novo, não reaproveitar
  // este.
  minArea Float?
  maxArea Float?

  // Espelha a separação real de Property (propertyFeatures/condoFeatures,
  // dois catálogos/categorias distintos em FeatureOption) — matching
  // futuro compara cada array contra o campo correspondente do imóvel,
  // sem precisar decidir a categoria de cada string em tempo de match.
  desiredPropertyFeatures String[] @default([])
  desiredCondoFeatures    String[] @default([])

  // Observações específicas do que a pessoa procura no imóvel — nunca
  // confundir com Person.notes (observações gerais sobre a pessoa).
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("person_preferences")
}

model Property {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  code              Int                @default(autoincrement())
  title             String
  description       String?
  type              String
  purpose           PropertyPurpose
  status            PropertyStatus     @default(DRAFT)
  isLaunch          Boolean            @default(false)
  isFeatured        Boolean            @default(false)
  isOpportunity     Boolean            @default(false)
  hasSlideshow      Boolean            @default(false)
  constructionStage ConstructionStage?
  deliveryForecast  DateTime?
  developer         String?

  // Endereço
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String
  city         String
  state        String
  latitude     Float?
  longitude    Float?

  // Valores
  price       Decimal? @db.Decimal(14, 2)
  rentPrice   Decimal? @db.Decimal(14, 2)
  condoFee    Decimal? @db.Decimal(14, 2)
  propertyTax Decimal? @db.Decimal(14, 2)

  // Características
  totalArea        Float?
  privateArea      Float?
  bedrooms         Int?
  suites           Int?
  bathrooms        Int?
  parkingSpots     Int?
  propertyFeatures String[] @default([])
  condoFeatures    String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  responsibleMemberId String?
  responsibleMember   OrganizationMember? @relation("PropertyResponsibleMember", fields: [responsibleMemberId], references: [id])

  ownerId String?
  owner   Person? @relation("PropertyOwner", fields: [ownerId], references: [id])

  media               Media[]
  leadCaptures        LeadCapture[]
  statusHistory       PropertyStatusHistory[]
  interactions        Interaction[]
  analyticsEvents     PropertyAnalyticsEvent[]
  deals               Deal[]
  portalListings      PortalListing[]
  interests           PropertyInterest[]
  scheduledActivities ScheduledActivity[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, city, neighborhood])
  @@index([organizationId, purpose, type])
  @@index([organizationId, isLaunch])
  // GIN: propertyFeatures/condoFeatures são filtrados com `hasSome` na
  // busca pública (src/app/[orgSlug]/imoveis/page.tsx) e no cálculo de
  // facetas (filtros-imoveis-data.ts) — mesma justificativa do índice de
  // Person.roles acima.
  @@index([propertyFeatures], type: Gin)
  @@index([condoFeatures], type: Gin)
  @@map("properties")
}

model Media {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type    MediaType
  url     String
  isCover Boolean   @default(false)
  order   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@map("media")
}

model PropertyStatusHistory {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  previousStatus PropertyStatus?
  newStatus      PropertyStatus
  changedAt      DateTime        @default(now())

  @@index([propertyId])
  @@map("property_status_history")
}

model Interaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  personId       String
  person         Person              @relation(fields: [personId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?           @relation(fields: [propertyId], references: [id])
  memberId       String?
  member         OrganizationMember? @relation("InteractionMember", fields: [memberId], references: [id])

  type       InteractionType
  notes      String?
  occurredAt DateTime        @default(now())

  // De onde veio o contato quando ele nasceu no site público: página do
  // imóvel, página de contato ou "anuncie seu imóvel" (catálogo em
  // código, ver src/lib/captacao.ts). String e não enum pelo mesmo
  // motivo do themeId: origens novas não devem exigir migration.
  //
  // Nullable e sem default de propósito: interação registrada à mão pelo
  // corretor no painel não tem origem de site, e as que já existiam
  // continuam null — nenhuma delas ganha uma origem inventada
  // retroativamente.
  origin String?

  // Atribuição de tráfego da jornada (Fase 7) — TODAS nullable, aditivas.
  // Evento anterior a esta fase permanece sem atribuição, e isso é lido
  // como "Sem atribuição" na tela: nunca houve backfill nem inferência.
  //
  // Denormalizado (as mesmas colunas também existem em Interaction) de
  // propósito: as agregações do dashboard leem estas linhas direto e
  // agrupam em memória; uma tabela de atribuição à parte obrigaria um
  // join em toda consulta e uma linha extra por evento, sem nenhum ganho.
  //
  // String livre normalizada, nunca enum: utm_* é texto escolhido por
  // terceiros (agência, plataforma de anúncio) e um enum quebraria na
  // primeira campanha nova. Normalização e limite ficam em
  // src/lib/atribuicao.ts, aplicados SEMPRE no servidor.
  //
  // referrerHost é só o HOSTNAME, nunca a URL completa — URLs de origem
  // carregam query string, token e às vezes dado pessoal.
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  referrerHost String?

  // Fase 8 — oportunidades criadas explicitamente a partir deste contato.
  originatedInterests PropertyInterest[] @relation("PropertyInterestSourceInteraction")
  leadCapture         LeadCapture?       @relation("LeadCaptureResolvedInteraction")

  @@index([personId])
  @@map("interactions")
}

// Estado ATUAL do relacionamento entre uma Person e um Property (Fase D do
// CRM) — nunca histórico. Histórico de eventos reais continua em Interaction
// (CALL/MESSAGE/EMAIL/VISIT/OTHER), sem nenhuma criação automática de
// Interaction a partir de mudanças aqui (decisão explícita: alterar stage ou
// favorited não gera Interaction — só ActivityLog).
//
// id próprio (não personId como PK, diferente de PersonPreference): a
// relação aqui é N:N — uma Person pode se interessar por vários Property, um
// Property pode interessar várias Person. A unicidade real é o PAR
// (organizationId, personId, propertyId), garantida pelo @@unique abaixo,
// nunca pela PK.
// Evento digital do site público sobre um imóvel (Fase 6) — a fonte de
// verdade das etapas VISUALIZAÇÃO e INTENÇÃO do funil. Catálogo de tipos
// e placements em código: src/lib/analytics-eventos.ts.
//
// Não guarda: IP, User-Agent, e-mail, telefone, nome, nem qualquer
// fingerprint de device. O único identificador é `visitorHash`, que já
// chega derivado e ESCOPADO por (visitante, organização, imóvel) — ver a
// justificativa completa em calcularVisitorHash.
//
// NÃO existe evento de "contato enviado" aqui de propósito: essa etapa
// continua sendo Interaction (origin ∈ ORIGENS_CAPTACAO), fonte única,
// sem dupla contagem. Ver cabeçalho de analytics-eventos.ts.
model PropertyAnalyticsEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Obrigatório: os dois eventos desta fase são, por definição, sobre um
  // imóvel específico. Um "view" sem imóvel não significaria nada.
  //
  // Cascade (não Restrict, não SetNull): telemetria É conteúdo do imóvel,
  // mesmo grupo de Media/PropertyStatusHistory/PortalListing, e não uma
  // relação de negócio como PropertyInterest/Deal. Restrict tornaria um
  // imóvel indeletável assim que recebesse a primeira visualização —
  // inaceitável. Consequência assumida: apagar um imóvel apaga o
  // histórico digital dele, e totais de períodos passados mudam. Na
  // prática o caminho normal do produto é status INACTIVE, não DELETE.
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // String validada por catálogo, não enum do Postgres — mesmo motivo de
  // Interaction.origin: tipo de evento novo não deve exigir migration.
  type String

  // Só faz sentido para WHATSAPP_CLICK (qual dos três CTAs). Null para
  // PROPERTY_VIEW. Coluna validada por catálogo em vez de JSON livre,
  // pra continuar sendo consultável e de cardinalidade fechada.
  placement String?

  // sha256(visitorId : organizationId : propertyId), 32 hex. Pseudônimo e
  // escopado: o mesmo visitante em outro imóvel produz um hash sem
  // relação computável com este.
  visitorHash String

  occurredAt DateTime @default(now())

  // Atribuição de tráfego da jornada (Fase 7) — TODAS nullable, aditivas.
  // Evento anterior a esta fase permanece sem atribuição, e isso é lido
  // como "Sem atribuição" na tela: nunca houve backfill nem inferência.
  //
  // Denormalizado (as mesmas colunas também existem em Interaction) de
  // propósito: as agregações do dashboard leem estas linhas direto e
  // agrupam em memória; uma tabela de atribuição à parte obrigaria um
  // join em toda consulta e uma linha extra por evento, sem nenhum ganho.
  //
  // String livre normalizada, nunca enum: utm_* é texto escolhido por
  // terceiros (agência, plataforma de anúncio) e um enum quebraria na
  // primeira campanha nova. Normalização e limite ficam em
  // src/lib/atribuicao.ts, aplicados SEMPRE no servidor.
  //
  // referrerHost é só o HOSTNAME, nunca a URL completa — URLs de origem
  // carregam query string, token e às vezes dado pessoal.
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  referrerHost String?

  // Índices derivados das DUAS queries reais que existem, não
  // especulativos:
  //   (1) agregações do dashboard — sempre organizationId + faixa de
  //       occurredAt, agrupando por type e/ou propertyId em memória;
  //   (2) deduplicação na escrita — organizationId + propertyId + type +
  //       visitorHash + occurredAt >= corte.
  @@index([organizationId, occurredAt])
  @@index([organizationId, propertyId, type, visitorHash, occurredAt])
  @@map("property_analytics_events")
}

model PropertyInterest {
  id             String       @id @default(cuid())
  // Sem onDelete explícito: relação obrigatória (String, não String?) sem
  // anotação já resolve pra RESTRICT por padrão no Prisma — mesmo
  // comportamento (silencioso) de Person.organizationId/Property.organizationId
  // em todo o schema. Organização nunca pode ser apagada com PropertyInterest
  // pendurado nela.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // RESTRICT (padrão implícito, relação obrigatória sem anotação — não
  // Cascade, não SetNull): diferente de Interaction.propertyId (opcional,
  // sobrevive à exclusão do imóvel porque uma Interaction pode ser um
  // contato genérico sem imóvel nenhum, e por isso é SET NULL), PropertyInterest
  // É sobre um imóvel específico — sem propertyId o registro perde todo o
  // sentido. Segue o mesmo precedente de Deal.propertyId (RESTRICT), não o
  // de Media/PropertyStatusHistory/PortalListing (CASCADE, que são conteúdo
  // do imóvel, não uma relação de negócio).
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  // Fase 8 — a Interaction de captação que ORIGINOU esta oportunidade.
  //
  // Nullable e sem default de propósito: até aqui, PropertyInterest só
  // nascia de três ações manuais do corretor (relacionar imóvel na ficha
  // do cliente, recomendação na ficha do cliente, recomendação na ficha
  // do imóvel), nenhuma delas partindo de um contato. Essas três
  // continuam existindo e continuam criando oportunidade SEM origem — o
  // que é a verdade, não uma lacuna a ser preenchida.
  //
  // Só a ação nova "Criar oportunidade" (a partir de um contato do site,
  // no histórico de interações) preenche este campo, e ela o faz com o id
  // da interação em que o corretor clicou — um fato, nunca um palpite.
  // NÃO existe backfill: nenhuma oportunidade histórica recebe origem
  // por proximidade de data, mesma Person ou mesmo imóvel.
  //
  // SetNull (não Cascade): apagar uma interação não pode destruir a
  // negociação que nasceu dela — a oportunidade continua válida, só
  // perde a atribuição.
  //
  // Sem snapshot dos campos de atribuição: a atribuição da Interaction é
  // escrita uma única vez, na criação, e nenhum fluxo a edita depois
  // (auditado na Fase 7), então a referência basta e evita duplicar seis
  // colunas que poderiam divergir.
  sourceInteractionId String?
  sourceInteraction   Interaction? @relation("PropertyInterestSourceInteraction", fields: [sourceInteractionId], references: [id], onDelete: SetNull)

  stage     PropertyInterestStage @default(INTERESTED)
  // Dimensão independente do stage — um cliente pode favoritar em qualquer
  // estágio, e desfavoritar não é uma "regressão" de funil. Nunca combinar
  // num único enum com stage (ver comentário de PropertyInterestStage).
  favorited Boolean               @default(false)

  notes String?

  // Momento real de encerramento como ganho ou perdido (Fase P.2) — nunca
  // confundir com updatedAt, que muda em QUALQUER escrita (stage, favorited
  // ou notes) e por isso não serve como "data de fechamento" (auditoria
  // P.1, seção 27). Nullable, sem default: fundação de schema apenas —
  // nenhum código desta fase escreve neste campo (permanece null pra todo
  // registro existente e novo até a P.3 criar a action de fechamento que o
  // preenche atomicamente junto da mudança de stage).
  closedAt DateTime?

  // Fase 9 — valor NEGOCIADO pelo qual a oportunidade foi fechada,
  // informado pelo corretor ao marcar como ganha. Decimal(14,2) igual a
  // todo campo monetário do schema (Property.price/rentPrice/condoFee/
  // propertyTax, PersonPreference.min/maxPrice) — nunca Float.
  //
  // Nullable, e isso é semântico, não só compatibilidade:
  //   null = valor NÃO REGISTRADO (ganho anterior a esta fase, ou
  //          fechamento por um caminho que não pede valor)
  //   0    = impossível — a validação recusa zero e negativo, porque
  //          "ganho por R$ 0" é campo em branco, não negócio fechado.
  // Somar null como zero puxaria ticket médio e total para baixo; os
  // relatórios tratam os dois casos separadamente (ver
  // agregarValorFechado em src/lib/valor-fechamento.ts).
  //
  // NÃO é receita nem comissão: seria a comissão sobre este valor, e o
  // produto não registra isso. NÃO é Property.price (preço anunciado).
  // ZERO BACKFILL: nenhum WON histórico recebeu valor inferido do imóvel.
  //
  // Só é escrito na transação de fechamento como GANHO. REJECTED nunca
  // grava valor. Não há fluxo de edição depois do fechamento (ver
  // fecharInteresse).
  closedValue Decimal? @db.Decimal(14, 2)

  // Fase 10 — COMISSÃO do negócio, em dinheiro, informada pela equipe.
  // Mesmo Decimal(14,2) de todo campo monetário do schema.
  //
  // POR QUE VALOR, E NÃO PERCENTUAL: o produto não tem NENHUMA regra de
  // comissão (auditado: nenhum campo, nenhuma configuração, nenhum
  // percentual em Organization/OrganizationSettings/Property, e o model
  // Deal segue sendo código morto). Sem regra, o único dado inequívoco é
  // o valor que a equipe confirmou. Guardar um percentual junto criaria
  // duas fontes de verdade que divergiriam quando o valor fosse
  // corrigido. A tela oferece um atalho de "%" que apenas CALCULA o
  // valor no navegador — nada de percentual é persistido.
  //
  // OPCIONAL, diferente de closedValue: a comissão frequentemente só é
  // definida depois do fechamento (contrato, repasse), e um negócio real
  // não pode deixar de ser registrado como ganho porque a comissão ainda
  // não saiu.
  //   null = comissão NÃO REGISTRADA (todo WON anterior a esta fase)
  //   0    = impossível — a validação recusa zero, para não confundir
  //          "não registrada" com "foi zero". Limitação documentada.
  //
  // NÃO é receita da imobiliária por construção: não existe split,
  // co-broker nem percentual do corretor no domínio, então este é o
  // valor da comissão DO NEGÓCIO. Ver src/lib/comissao.ts.
  // ZERO BACKFILL: nenhum WON histórico recebeu comissão estimada.
  commissionValue Decimal? @db.Decimal(14, 2)

  // Fase 11 — RESPONSÁVEL PELA NEGOCIAÇÃO.
  //
  // Ownership comercial da OPORTUNIDADE, e de mais nada. Auditoria da
  // fase: o produto tinha atores espalhados (Property.responsibleMember =
  // responsável pelo IMÓVEL; Person.assignedMember = responsável pelo
  // CLIENTE; Interaction.member = quem REGISTROU o contato;
  // ScheduledActivity.createdByMember = quem CRIOU a visita;
  // ActivityLog.userId = quem EXECUTOU cada ação) e nenhum deles
  // respondia "quem conduz esta negociação". Nenhum foi reaproveitado:
  // captar o imóvel, atender o cliente e conduzir a negociação são
  // funções que podem pertencer a pessoas diferentes.
  //
  // IDENTIDADE TENANT-SPECIFIC: aponta para OrganizationMember, nunca
  // para User. User é identidade global e atravessa organizações; a
  // responsabilidade comercial é com ESTA imobiliária. Mesmo alvo de
  // Property.responsibleMember e Person.assignedMember.
  //
  // NULLABLE, sem backfill: toda negociação anterior a esta fase fica
  // null = "Sem responsável", declarado como tal na tela. Nenhuma
  // heurística de criador, último ActivityLog, quem marcou WON,
  // responsável pelo imóvel, responsável pela visita ou proximidade
  // temporal — nada disso é o responsável pela negociação, e adivinhar
  // seria fabricar accountability.
  //
  // FK ON DELETE SET NULL — não por default acidental, mas porque é a
  // política que TODAS as FKs de ownership deste produto já usam,
  // verificado no banco (pg_constraint): people.assignedMemberId,
  // properties.responsibleMemberId, interactions.memberId e
  // scheduled_activities.createdByMemberId são as quatro SET NULL. Um
  // RESTRICT aqui seria a anomalia do schema.
  //
  // O histórico não depende da FK para sobreviver, e sim do LIFECYCLE
  // real, auditado nesta fase: membro NUNCA é apagado no ciclo de vida do
  // tenant — /app/usuarios só alterna status ACTIVE <-> SUSPENDED e não
  // existe nenhuma ação de exclusão de membro. O único delete real é o da
  // organização inteira (operador de plataforma), que já apaga
  // propertyInterest ANTES de organization_members. Ou seja: no uso real
  // este SET NULL nunca dispara, e uma negociação histórica nunca perde
  // silenciosamente o seu responsável.
  //
  // Membro SUSPENSO continua sendo o responsável histórico e continua
  // aparecendo com nome + marca de inativo — desativar não é apagar.
  //
  // IMUTÁVEL DEPOIS DE FECHADO: a transferência é bloqueada em
  // WON/REJECTED (ver transferirResponsavelNegociacao), justamente para
  // que o Analytics do período não possa ser reescrito depois. É por
  // isso que NÃO existe um closedByResponsibleMemberId: sem mutação
  // pós-fechamento, o snapshot seria uma cópia do mesmo dado.
  //
  // NÃO É BENEFICIÁRIO FINANCEIRO: responsável pela negociação não
  // significa quem recebe a comissão. Sem split/co-broker/percentual no
  // domínio, commissionValue continua sendo "comissão do negócio".
  responsibleMemberId String?
  responsibleMember   OrganizationMember? @relation("PropertyInterestResponsibleMember", fields: [responsibleMemberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledActivities ScheduledActivity[]
  stageHistory        PropertyInterestStageHistory[]
  // Fase 12 — divisão da comissão deste negócio. Lista VAZIA por padrão:
  // não existe split presumido, nem 100% para o responsável.
  participants        PropertyInterestParticipant[]

  // @@unique([organizationId, personId, propertyId]) já serve, por prefixo
  // esquerdo, tanto consultas só por organizationId quanto por
  // (organizationId, personId) — índices próprios pra esses dois casos
  // seriam redundantes. propertyId é a terceira coluna da unique (não
  // prefixo), por isso o índice (organizationId, propertyId) continua
  // sendo o único jeito de servir a ficha do imóvel eficientemente.
  @@unique([organizationId, personId, propertyId])
  @@index([organizationId, propertyId])
  // Fase 11 — serve o filtro por responsável do Kanban ("Meus negócios" /
  // corretor X) e o agrupamento do Analytics. Adicionado por MEDIÇÃO, não
  // por reflexo: EXPLAIN (ANALYZE, BUFFERS) em banco descartável com
  // 200.000 negociações e 40 organizações, na query real
  // (organizationId + responsibleMemberId):
  //   sem índice -> Parallel Seq Scan, 2079 buffers, 10,19 ms
  //   com índice -> Bitmap Index Scan,    4 buffers,  0,84 ms
  // Sem ele, filtrar o Kanban de uma organização varre a tabela inteira,
  // incluindo as linhas de todos os outros tenants.
  @@index([organizationId, responsibleMemberId])
  @@map("property_interests")
}

// Trilha temporal de mudanças de PropertyInterest.stage (Fase P.6) — mesmo
// papel de PropertyStatusHistory pra Property.status, mesma convenção de
// nomes (previousX/newX, changedAt @default(now())): fato estruturado e
// consultável, nunca substitui `stage` (única fonte do estado atual) nem
// ActivityLog (auditoria/evento de aplicação, payload solto, não indexado
// pra range de data por stage). Zero PII aqui de propósito — nada de nome,
// email, telefone, notes ou título de imóvel.
//
// previousStage nullable: a primeira transição registrada de um
// PropertyInterest não tem "de onde" antes dela — nunca inventado/inferido
// pra registros anteriores a esta fase (migration é só estrutural, sem
// backfill; ausência de histórico = aging indisponível, nunca uma origem
// fake). newStage obrigatório: toda linha representa uma transição que de
// fato aconteceu, gravada na MESMA transação que a mudança de stage.
// =======================================================================
// Participante da negociação (Fase 12)
// =======================================================================
// Quem tem participação ECONÔMICA num negócio, e quanto da comissão foi
// atribuído a essa pessoa.
//
// POR QUE UMA TABELA NOVA: auditoria da fase varreu participant/split/
// co-broker/parceiro/beneficiário/repasse/percentual em schema,
// migrations, actions, analytics, roles e testes — não existia NADA.
// `DealPerson` parece um join de participação, mas liga Deal a Person
// (os CLIENTES do negócio), e Deal segue sendo código morto. Cenário C:
// o domínio precisava ser criado.
//
// NÃO É O RESPONSÁVEL. PropertyInterest.responsibleMemberId diz quem
// CONDUZ a negociação; esta tabela diz quem PARTICIPA do dinheiro. São
// dimensões diferentes e coexistem: o responsável só vira participante
// se alguém disser explicitamente que ele é.
//
// SEM DEFAULT: nenhuma linha nasce sozinha. Não existe "100% para o
// responsável", não existe 50/50, não existe percentual de mercado.
// Comissão sem participante é comissão NÃO DISTRIBUÍDA, e a tela diz
// isso em vez de inventar um destino.
model PropertyInterestParticipant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // CASCADE: participação não existe sem a negociação. É também o que
  // mantém a ordem de exclusão da organização inteira correta — os
  // participantes somem junto com o PropertyInterest, que já é apagado
  // antes de organization_members.
  propertyInterestId String
  propertyInterest   PropertyInterest @relation(fields: [propertyInterestId], references: [id], onDelete: Cascade)

  // RESTRICT (default do Prisma para relação obrigatória) — e aqui a
  // escolha é DELIBERADAMENTE diferente da política SET NULL usada pelas
  // FKs de ownership. Uma alocação financeira sem beneficiário seria
  // "R$ 20.000 atribuídos a ninguém": pior que um erro, é um dado que
  // mente. Membro nunca é apagado no ciclo de vida do tenant (auditado
  // na Fase 11: /app/usuarios só alterna ACTIVE <-> SUSPENDED), então na
  // prática este RESTRICT nunca dispara — ele existe para que a
  // identidade financeira não possa ser perdida em silêncio.
  memberId String
  member   OrganizationMember @relation("ParticipantMember", fields: [memberId], references: [id])

  // Parcela da comissão atribuída a este participante, em dinheiro.
  //
  // FONTE DE VERDADE ÚNICA, mesma decisão da Fase 10: nenhum percentual é
  // persistido. A tela oferece um atalho de "%" que só CALCULA o valor no
  // navegador; guardar os dois criaria duas fontes que divergem na
  // primeira correção do total.
  //
  // OPCIONAL: dá para registrar QUEM participou antes de saber QUANTO —
  // a comissão total costuma ser definida depois do fechamento.
  //   null = parcela ainda não definida (declarado na tela)
  //   0    = impossível, a validação recusa; "sem parcela" já se diz com
  //          null, e aceitar zero confundiria os dois estados.
  // Atribuir valor exige commissionValue conhecida: sem total, não há
  // limite contra o qual validar a soma.
  allocationValue Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Fase 13 — ledger de pagamentos desta parcela. Lista vazia = nada
  // pago; atribuir NUNCA implica pagar.
  payments PropertyInterestParticipantPayment[]

  // Uma participação por membro por negociação. Duas linhas do mesmo
  // membro tornariam a soma ambígua e a edição imprevisível.
  @@unique([propertyInterestId, memberId])
  // Serve a leitura real do Analytics ("participações desta organização
  // no período") e o agrupamento por membro. O carregamento por
  // negociação já é servido pelo prefixo esquerdo da @@unique acima.
  @@index([organizationId, memberId])
  @@map("property_interest_participants")
}

// =======================================================================
// Pagamento de comissão (Fase 13)
// =======================================================================
// LEDGER de liquidação: cada linha é um pagamento que ACONTECEU.
//
// A cadeia financeira do produto tem quatro conceitos distintos, e este
// model existe para que o quarto pare de ser inferido:
//   commissionValue  comissão TOTAL do negócio          (Fase 10)
//   allocationValue  parcela ATRIBUÍDA ao participante  (Fase 12)
//   Σ pagamentos     o que foi de fato PAGO             (esta fase)
//   pendente         allocationValue - Σ pagamentos     (derivado)
//
// POR QUE UM LEDGER, E NÃO `paidValue` OU `paid Boolean`: um único campo
// responderia "quanto" e perderia quando, em quantas vezes, quem
// registrou e o que foi corrigido. Pagamento de comissão é parcelado na
// prática, e um booleano forçaria liquidação integral numa tacada.
//
// POR QUE NÃO REUSAR O `Payment` QUE JÁ EXISTE: aquele é do billing da
// PLATAFORMA (Payment -> Invoice -> Subscription), dinheiro que a easymob
// cobra da imobiliária — sentido oposto do fluxo, em amountCents Int,
// com status de gateway e externalId, operado por operador de
// plataforma. Nada ali descreve repasse de comissão a um corretor.
model PropertyInterestParticipantPayment {
  id             String       @id @default(cuid())
  // Redundante com participant.organizationId de propósito: a extensão
  // de tenant-scoping (src/lib/prisma.ts) só reconhece organizationId
  // como chave DIRETA do where, e o Analytics consulta pagamentos por
  // organização + data sem passar pelo participante. A consistência é
  // garantida na escrita, dentro da mesma transação que valida o
  // participante.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // RESTRICT: pagamento não existe sem a parcela a que pertence, e
  // apagar uma participação que já tem histórico financeiro destruiria o
  // registro do que foi pago. A remoção de participante com pagamento é
  // bloqueada na action, e esta FK é a rede embaixo disso.
  // Diferente do CASCADE que liga o participante à negociação: lá a
  // linha é uma atribuição, aqui é um fato consumado.
  participantId String
  participant   PropertyInterestParticipant @relation(fields: [participantId], references: [id])

  // Sempre > 0. Estorno NÃO é valor negativo — é cancelamento (abaixo),
  // para que a soma paga nunca dependa de interpretar sinal.
  amount Decimal @db.Decimal(14, 2)

  // QUANDO O PAGAMENTO OCORREU — jamais confundido com createdAt, que é
  // quando alguém digitou. São coisas diferentes: um pagamento de ontem
  // pode ser registrado hoje. Todo recorte temporal de liquidação usa
  // paidAt. Data futura é recusada: esta linha é fato consumado, não
  // previsão (previsão seria outro domínio, fora desta fase).
  paidAt DateTime

  // Ator ADMINISTRATIVO, em identidade tenant-specific — ActivityLog só
  // guarda User, que é global e atravessa organizações. SET NULL (e não
  // RESTRICT como o participante) porque isto é rastro de conveniência,
  // não a identidade do dinheiro: quem RECEBE é o participante. Mesma
  // política de ScheduledActivity.createdByMember.
  createdByMemberId String?
  createdByMember   OrganizationMember? @relation("PaymentCreatedByMember", fields: [createdByMemberId], references: [id])

  // SOFT-CANCEL, nunca delete: registro financeiro apagado não deixa
  // rastro de que existiu. Cancelado sai da soma paga (deixa de ser
  // "pagamento válido") mas continua visível no histórico. É também o
  // mecanismo de CORREÇÃO: erro de digitação se conserta cancelando e
  // registrando o valor certo, em vez de reescrever um fato. Mesmo
  // padrão de ScheduledActivity.cancelledAt.
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledByMember   OrganizationMember? @relation("PaymentCancelledByMember", fields: [cancelledByMemberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Carregamento do ledger de uma parcela, já ordenado pela data do fato.
  @@index([participantId, paidAt])
  // Recorte do Analytics: "quanto foi pago nesta organização no período",
  // que é uma coorte por paidAt e não passa pelo participante.
  @@index([organizationId, paidAt])
  @@map("property_interest_participant_payments")
}

model PropertyInterestStageHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propertyInterestId String
  propertyInterest   PropertyInterest @relation(fields: [propertyInterestId], references: [id], onDelete: Cascade)

  previousStage PropertyInterestStage?
  newStage      PropertyInterestStage

  changedAt DateTime @default(now())

  // Fase 14 — QUEM executou esta transição. Fecha a última lacuna de
  // accountability do funil: até aqui sabia-se quando o card mudou de
  // etapa, e não por quem.
  //
  // O NOME pareia com `changedAt` acima: mesma transição, quando e por
  // quem. Identidade TENANT-SPECIFIC (OrganizationMember), nunca User —
  // User é global e atravessa organizações, e era exatamente por isso
  // que ActivityLog.userId não servia como ator do histórico.
  //
  // ATOR != RESPONSÁVEL. PropertyInterest.responsibleMemberId diz quem
  // CONDUZ a negociação; este campo diz quem MOVEU aquela etapa. Um
  // gerente pode fechar o negócio de outra pessoa: o histórico registra
  // o gerente, e o responsável não muda. Também não se confunde com o
  // createdByMemberId do ledger de pagamentos (Fase 13) — ali é quem
  // registrou dinheiro, aqui é quem moveu o funil.
  //
  // NULLABLE por três motivos reais, e o null significa "ator não
  // registrado", jamais "ninguém moveu":
  //   1. histórico legado — ZERO BACKFILL, nada foi inferido de
  //      ActivityLog próximo, de quem marcou WON, do responsável atual
  //      nem de proximidade de timestamp;
  //   2. sessão sem vínculo de organização, estado possível no produto;
  //   3. membro que não pertence à organização da negociação é redigido
  //      para null em vez de gravar FK cross-tenant.
  //
  // SET NULL, seguindo a convenção de ATOR do projeto
  // (ScheduledActivity.createdByMember e os dois atores do ledger) — e
  // deliberadamente diferente do RESTRICT usado para o BENEFICIÁRIO
  // financeiro na Fase 13: perder quem moveu um card degrada auditoria,
  // perder quem recebeu dinheiro corromperia o dado. Na prática nunca
  // dispara: membro não é apagado no ciclo de vida do tenant.
  changedByMemberId String?
  changedByMember   OrganizationMember? @relation("StageHistoryChangedByMember", fields: [changedByMemberId], references: [id])

  // Serve exatamente a query "última transição por PropertyInterest" (Kanban
  // aberto, batched via include aninhado — mesmo padrão de
  // scheduledActivities). Nenhum índice adicional: não há consulta
  // planejada de "todo histórico da organização por data" nesta fase.
  @@index([organizationId, propertyInterestId, changedAt])
  @@map("property_interest_stage_history")
}

// Agenda de atividades futuras vinculadas a uma Person (Fase H do CRM) —
// nunca reaproveita Interaction como agenda: Interaction é histórico do que
// já ocorreu, ScheduledActivity é o que está marcado pra ocorrer. V1 só cria
// type=VISIT (ver ScheduledActivityType). completedAt/cancelledAt registram
// quando o status mudou de SCHEDULED — nunca ambos preenchidos ao mesmo
// tempo, mas isso não é validado em nível de banco nesta fase (mesmo nível
// de simplicidade de PropertyInterestStage/Person.pipelineStage: nenhuma
// transição de status é validada no schema).
model ScheduledActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  propertyInterestId String?
  propertyInterest   PropertyInterest? @relation(fields: [propertyInterestId], references: [id])

  createdByMemberId String?
  createdByMember   OrganizationMember? @relation("ScheduledActivityCreatedByMember", fields: [createdByMemberId], references: [id])

  type   ScheduledActivityType   @default(VISIT)
  status ScheduledActivityStatus @default(SCHEDULED)

  scheduledAt DateTime
  completedAt DateTime?
  cancelledAt DateTime?

  // O QUE precisa ser feito (Fase 19) — só para FOLLOW_UP: "Enviar
  // proposta revisada", "Cobrar documentos". É o próprio compromisso,
  // não uma observação sobre ele.
  //
  // NULLABLE no schema, com zero backfill, e OBRIGATÓRIO em regra de
  // aplicação para FOLLOW_UP — exatamente o mesmo padrão que a H.2 já
  // usa para propertyId/propertyInterestId em VISIT. VISIT não tem
  // assunto: o assunto de uma visita é visitar o imóvel, e escrever um
  // texto genérico nas linhas existentes seria inventar dado.
  //
  // NÃO se confunde com `notes` abaixo, que a H.6 definiu como
  // observação OPERACIONAL do agendamento e continua com esse
  // significado para os dois tipos:
  //   subject: "Enviar proposta"
  //   notes:   "Cliente pediu opção com entrada menor."
  subject String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, personId, scheduledAt])
  @@index([organizationId, propertyId, scheduledAt])
  @@index([organizationId, propertyInterestId, scheduledAt])
  @@index([organizationId, status, scheduledAt])
  @@map("scheduled_activities")
}

model Deal {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property            @relation(fields: [propertyId], references: [id])
  memberId       String?
  member         OrganizationMember? @relation("DealMember", fields: [memberId], references: [id])

  type       DealType
  finalValue Decimal  @db.Decimal(14, 2)
  commission Decimal? @db.Decimal(14, 2)
  closedAt   DateTime @default(now())

  people DealPerson[]

  @@index([propertyId])
  @@map("deals")
}

model DealPerson {
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id])

  @@id([dealId, personId])
  @@map("deal_people")
}

// Registro de envio/sincronização de um imóvel para um portal externo (ZAP, VivaReal, OLX, Imovelweb, Mercado Livre).
model PortalListing {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  propertyId        String
  property          Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  portal            String
  externalListingId String?
  lastSyncedAt      DateTime?
  lastError         String?

  @@unique([propertyId, portal])
  @@map("portal_listings")
}

// Catálogo de opções selecionáveis para as características do imóvel/condomínio (gerenciado em /admin/caracteristicas).
model FeatureOption {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  category       FeatureCategory
  createdAt      DateTime        @default(now())

  @@unique([organizationId, category, name])
  @@map("feature_options")
}

// Catálogo de tipos de imóvel selecionáveis, residencial/comercial (gerenciado em /admin/tipos-imovel).
model PropertyTypeOption {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  category       PropertyTypeCategory
  createdAt      DateTime             @default(now())

  @@unique([organizationId, category, name])
  @@map("property_type_options")
}

// =====================================================================
// Fundação multi-tenant (EasyMob) — ver /Users/alexboccia/.claude/plans/
// glittery-noodling-harp.md para o plano completo.
// =====================================================================

// ---------- Tenancy & RBAC ----------

// Modos de visibilidade da carteira comercial (Fase 22).
//
// COLLABORATIVE — comportamento histórico: todo membro com o módulo CRM
//   consulta a carteira da organização. É o padrão, e continua sendo o
//   modo certo para uma imobiliária pequena que trabalha em conjunto.
//
// RESTRICTED — o membro operacional (BROKER/ASSISTANT) enxerga apenas a
//   carteira comercial com que tem vínculo; a camada gerencial
//   (PAPEIS_VISAO_EQUIPE: OWNER/ADMIN/MANAGER) mantém a visão da
//   organização inteira. Ver src/lib/escopo-comercial.ts para o que
//   "vínculo" significa em cada entidade — Person e PropertyInterest têm
//   semânticas diferentes e NÃO usam o mesmo predicado.
//
// A política muda AUTORIZAÇÃO, nunca dado: trocar de modo não reescreve
// responsibleMemberId, assignedMemberId nem nada.
enum CommercialVisibility {
  COLLABORATIVE
  RESTRICTED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  BROKER
  ASSISTANT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Fase 25 — INSTANTE DA ÚLTIMA TROCA DE SENHA. Existe por um motivo
  // só: a sessão é JWT (stateless, src/lib/auth.config.ts), então não há
  // tabela de sessões para apagar depois de um reset. Comparar este
  // instante com o `iat` do token é o equivalente stateless — quem
  // trocou a senha derruba as sessões emitidas ANTES da troca.
  //
  // NULL para todo usuário existente, de propósito: null significa
  // "nunca trocou", e nenhuma sessão em curso é invalidada pelo deploy.
  passwordChangedAt DateTime?
  active       Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         OrganizationMember[]
  inviteTokens        InviteToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  // Contatos OPERACIONAIS do membro (uso interno/administrativo): é o
  // número que a equipe usa entre si e nas ferramentas do painel. Não são
  // dados de publicação — ver os campos public* abaixo, que existem
  // justamente porque um número cadastrado pra trabalhar não é
  // consentimento pra aparecer no site.
  whatsapp       String?
  contactEmail   String?

  // ---------- Identidade comercial pública do profissional ----------
  // Separada da identidade interna (User.name/avatarUrl, que existem pro
  // painel e são globais ao User, atravessando organizações). Estes
  // campos vivem no VÍNCULO porque a identidade profissional é com a
  // imobiliária: o mesmo User pode atuar em duas organizações com CRECI,
  // foto e apresentação diferentes — e autorizado a aparecer em uma sem
  // estar em outra.
  //
  // publicProfileEnabled é o ÚNICO portão de publicação e nasce false:
  // nenhum membro existente passa a aparecer no site por causa desta
  // migration, e papel (OWNER/ADMIN), ser responsável por um imóvel, ter
  // WhatsApp ou ter avatar NÃO implicam publicação. Desligar a flag para
  // de publicar sem apagar nada — dá pra preparar o perfil antes e
  // despublicar depois sem perder o conteúdo.
  publicProfileEnabled Boolean @default(false)
  publicCreci          String?
  publicPhotoUrl       String?
  publicBio            String?
  // WhatsApp declarado PARA o site, separado do operacional acima. Sem
  // ele o CTA do imóvel cai no número institucional da organização — o
  // número de trabalho do membro nunca é publicado por conveniência.
  publicWhatsapp       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationPreferences    NotificationPreference[]
  responsibleProperties      Property[]                           @relation("PropertyResponsibleMember")
  // Fase 11 — negociações sob responsabilidade deste membro. Relação
  // SEPARADA de responsibleProperties de propósito: ser responsável pelo
  // imóvel não torna ninguém responsável pela negociação daquele imóvel.
  responsibleInterests       PropertyInterest[]                   @relation("PropertyInterestResponsibleMember")
  // Fase 12 — participações econômicas em negócios. SEPARADA de
  // responsibleInterests de propósito: conduzir a negociação não implica
  // receber parcela nenhuma da comissão.
  commissionParticipations   PropertyInterestParticipant[]        @relation("ParticipantMember")
  // Fase 13 — pagamentos de comissão REGISTRADOS por este membro (ator
  // administrativo), não recebidos por ele. Quem recebe é determinado
  // pelo participante, nunca por estas relações.
  // Fase 14 — transições de etapa executadas por este membro. Relação
  // SEPARADA das demais: mover o funil não é conduzir a negociação nem
  // receber comissão.
  stageChanges               PropertyInterestStageHistory[]       @relation("StageHistoryChangedByMember")
  registeredPayments         PropertyInterestParticipantPayment[] @relation("PaymentCreatedByMember")
  cancelledPayments          PropertyInterestParticipantPayment[] @relation("PaymentCancelledByMember")
  assignedPeople             Person[]                             @relation("PersonAssignedMember")
  leadCapturesResolvidas     LeadCapture[]                        @relation("LeadCaptureResolvedByMember")
  interactions               Interaction[]                        @relation("InteractionMember")
  deals                      Deal[]                               @relation("DealMember")
  createdScheduledActivities ScheduledActivity[]                  @relation("ScheduledActivityCreatedByMember")

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Organization {
  id           String   @id @default(cuid())
  slug         String   @unique
  // Vestigial (Fase 2 do multi-tenant original) — nunca lido por nenhum
  // código de aplicação (confirmado por grep antes da Fase P.10). Fase
  // P.10 introduz OrganizationDomain (múltiplos domínios, status,
  // verificação) como o mecanismo real; esta coluna fica intocada
  // (migration aditiva-only, nunca DROP) até uma fase futura confirmar
  // que está seguro removê-la.
  customDomain String?  @unique
  name         String
  cnpj         String?
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Fuso horário comercial da organização (Fase 18) — identificador IANA
  // ("America/Sao_Paulo", "Europe/Lisbon", "UTC"), NUNCA offset fixo
  // ("-03:00"), que não descreve DST nem passado nem futuro. Valida
  // contra a lista canônica do runtime em src/lib/fuso-horario.ts.
  //
  // NULLABLE de propósito, com zero backfill: o produto não sabe o fuso
  // de nenhuma organização existente (não há endereço confiável nem
  // configuração anterior de onde inferir), e escrever America/Sao_Paulo
  // para todo mundo seria inventar um dado. null resolve para o fallback
  // explícito FUSO_PADRAO = "UTC", que é EXATAMENTE o comportamento
  // histórico — nenhum calendário se desloca sozinho sob uma organização
  // que não pediu nada. Configurar depois é um clique em Configurações.
  //
  // Só interpreta CALENDÁRIO (hoje/atrasadas/próximas, períodos do
  // Analytics, exibição). Nenhum instante persistido depende deste campo:
  // mudar o fuso não reescreve scheduledAt/occurredAt/closedAt/paidAt.
  timezone     String?

  // Fase 22 — POLÍTICA DE VISIBILIDADE COMERCIAL.
  //
  // Responde "quem pode ver qual parte da carteira?". Até aqui a
  // resposta era implícita e única: qualquer membro com o módulo CRM
  // enxergava a organização inteira. Isso nunca foi decisão registrada,
  // era ausência de decisão.
  //
  // ENUM, não boolean: `restrictBrokerVisibility` envelheceria mal no
  // dia em que surgir um terceiro modo (por equipe, por carteira, por
  // região), e o domínio aqui é um MODO, não uma chave liga/desliga.
  //
  // NOT NULL com @default(COLLABORATIVE) — e isso não é backfill
  // inventado: COLLABORATIVE é a descrição exata do comportamento que
  // toda organização existente já tem hoje. Nenhum tenant perde acesso
  // no deploy; quem quiser restringir escolhe em Configurações.
  commercialVisibility CommercialVisibility @default(COLLABORATIVE)

  // Fase P.9: preço mensal CONTRATADO desta organização, quando diverge do
  // padrão do plano (plan.priceMonthlyCents) — null = usa o padrão do
  // plano. Nunca sobrescreve plan.priceMonthlyCents; resolvido junto com
  // os limites efetivos em resolverEntitlementsOrganizacao.
  priceMonthlyCentsOverride Int?

  members                             OrganizationMember[]
  limitOverrides                      OrganizationLimitOverride[]
  settings                            OrganizationSettings?
  branding                            OrganizationBranding?
  subscriptions                       Subscription[]
  invoices                            Invoice[]
  billingEvents                       BillingEvent[]
  activityLogs                        ActivityLog[]
  notifications                       Notification[]
  aiUsages                            AiUsage[]
  people                              Person[]
  personPreferences                   PersonPreference[]
  propertyInterests                   PropertyInterest[]
  propertyInterestStageHistory        PropertyInterestStageHistory[]
  scheduledActivities                 ScheduledActivity[]
  properties                          Property[]
  media                               Media[]
  propertyStatusHistory               PropertyStatusHistory[]
  interactions                        Interaction[]
  analyticsEvents                     PropertyAnalyticsEvent[]
  deals                               Deal[]
  portalListings                      PortalListing[]
  featureOptions                      FeatureOption[]
  propertyTypeOptions                 PropertyTypeOption[]
  inviteTokens                        InviteToken[]
  domains                             OrganizationDomain[]
  emailDomain                         OrganizationEmailDomain?
  propertyInterestParticipants        PropertyInterestParticipant[]
  propertyInterestParticipantPayments PropertyInterestParticipantPayment[]
  leadCaptures                        LeadCapture[]

  @@map("organizations")
}

model OrganizationSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  phone              String?
  email              String?
  whatsapp           String?
  instagram          String?
  facebook           String?
  youtube            String?
  linkedin           String?
  propertyCodePrefix String?
  logoUrl            String?
  logoHeight         Int?
  // Logotipo dedicado ao rodapé do site público (fundo pode ser escuro —
  // ver OrganizationBranding.footerAppearance) — mesmo asset de sempre
  // (R2, upload por /api/admin/upload), só um segundo slot, opcional. Sem
  // isto, o rodapé cai no MESMO logoUrl do cabeçalho (ver SiteFooter.tsx).
  footerLogoUrl      String?
  // Altura (px) do logotipo no rodapé — equivalente a logoHeight, mas
  // independente: o rodapé costuma pedir um tamanho diferente do
  // cabeçalho (fundo escuro, versão alternativa do logo). null = altura
  // padrão do rodapé (ver LOGO_RODAPE_ALTURA_PADRAO em src/lib/logo.ts),
  // que é exatamente o tamanho fixo que o rodapé usava antes deste campo
  // existir — nenhum tenant muda de aparência por não ter configurado.
  footerLogoHeight   Int?
  // Imagem de fundo do Hero da Home pública (site/[orgSlug]/page.tsx) —
  // mesmo asset de sempre (R2, upload por /api/admin/upload, pasta
  // "hero", sempre reprocessada/recodificada, ver hero-image-processar.ts).
  // null (nenhum tenant enviou ainda, ou "Restaurar imagem padrão") cai
  // no fallback estático do produto (IMAGEM_HERO_PADRAO, site-config.ts)
  // — a Home nunca fica sem Hero.
  heroImageUrl       String?
  updatedAt          DateTime     @updatedAt

  @@map("organization_settings")
}

// Tema visual do site público — só a escolha (themeId aponta pro catálogo
// fixo em código, ver src/lib/branding/temas.ts) e o favicon. Logo
// continua vindo só de OrganizationSettings.logoUrl (não duplicar). A
// ausência desta linha é um estado válido: resolverTema() trata como
// "classic-blue" — nenhum tenant existente quebra por não ter branding
// configurado.
//
// Fase P.10: displayName é o ÚNICO campo novo aqui. Cores (primary/
// secondary/accent) foram deliberadamente NÃO adicionadas como hex livre
// — o catálogo de temas (CATALOGO_TEMAS, src/lib/branding/temas.ts) já
// resolve exatamente o problema que P.10.5.3 descreve (evitar CSS/cor
// arbitrária vinda do banco), e é mais seguro: zero superfície de
// injeção, sem precisar de validação Zod de hex. Duplicar com campos hex
// soltos reabriria o risco que o catálogo existe pra fechar. Ver
// relatório da Fase P.10, item "branding" — decisão documentada.
//
// customTheme (abaixo) NÃO reabre esse risco: nunca é texto livre vindo
// de um input do usuário — é sempre o JSON gerado deterministicamente a
// partir do logotipo (src/lib/branding/gerar-paleta.ts), nunca aceito
// vindo do client (nem no "gerar" nem no "aplicar", ver
// aplicarPaletaGerada em configuracoes/actions.ts), e revalidado
// estritamente por tokensTemaSchema (7 chaves fixas, cada uma
// "oklch(L C H)") toda vez que é lido de volta — mesmo shape/rigor do
// catálogo fixo, só que gerado em vez de escrito à mão.
model OrganizationBranding {
  organizationId   String       @id
  organization     Organization @relation(fields: [organizationId], references: [id])
  displayName      String?
  themeId          String       @default("classic-blue")
  faviconUrl       String?
  // Aparência do rodapé público — mesmo racional de themeId acima:
  // catálogo FIXO em código ("AUTO" | "PRIMARY" | "LIGHT", ver
  // src/lib/branding/aparencia-rodape.ts), nunca cor/CSS livre vinda do
  // banco. "AUTO" (variação escura derivada do tema via color-mix, sem
  // precisar de um token novo por tema) é o padrão — mesmo visual que o
  // rodapé já tinha antes deste campo existir, nenhum tenant existente
  // muda de aparência só por essa migration.
  footerAppearance String       @default("AUTO")
  // Tema gerado automaticamente a partir do logotipo (ver comentário
  // acima do model) — só é lido quando themeId = "custom"
  // (THEME_ID_CUSTOMIZADO, temas.ts). null enquanto ninguém gerou/aplicou
  // uma paleta ainda; nenhum tenant existente é afetado por este campo
  // (themeId continua "classic-blue" por padrão).
  customTheme      Json?
  updatedAt        DateTime     @updatedAt

  @@map("organization_branding")
}

// ---------- Permissões (RBAC preparado, não hardcoded) ----------

model Permission {
  id          String @id @default(cuid())
  code        String @unique // "properties.create", "crm.view", "billing.manage"...
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

