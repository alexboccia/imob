// Schema do sistema imobiliário — ver PRD.md (seção 9) para o modelo de dados de alto nível.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum PapelUsuario {
  ADMINISTRADOR
  GESTOR
  CORRETOR
}

enum EstagioObra {
  NA_PLANTA
  EM_CONSTRUCAO
  PRONTO_PARA_MORAR
}

enum FinalidadeImovel {
  VENDA
  ALUGUEL
  VENDA_E_ALUGUEL
}

enum CategoriaTipoImovel {
  RESIDENCIAL
  COMERCIAL
}

enum StatusImovel {
  RASCUNHO
  DISPONIVEL
  RESERVADO
  VENDIDO
  ALUGADO
  INATIVO
}

enum TipoMidia {
  FOTO
  VIDEO
  PLANTA
}

enum PapelPessoa {
  LEAD
  CLIENTE
  PROPRIETARIO
}

enum OrigemLead {
  SITE
  INDICACAO
  PORTAL
  INSTAGRAM
  WHATSAPP
  OUTRO
}

enum EstagioFunil {
  NOVO_LEAD
  CONTATO_FEITO
  VISITA_AGENDADA
  PROPOSTA
  FECHADO
  PERDIDO
}

enum TipoNegocio {
  VENDA
  LOCACAO
}

enum CategoriaCaracteristica {
  IMOVEL
  CONDOMINIO
}

enum TipoInteracao {
  VISITA
  LIGACAO
  MENSAGEM
  EMAIL
  OUTRO
}

// ---------- Modelos ----------

model Usuario {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(CORRETOR)
  ativo     Boolean      @default(true)
  foto      String?
  whatsapp  String?
  emailContato String?
  criadoEm  DateTime     @default(now())
  atualizadoEm DateTime  @updatedAt

  imoveis      Imovel[]      @relation("CorretorResponsavel")
  interacoes   Interacao[]
  negocios     Negocio[]
  pessoasLead  Pessoa[]      @relation("CorretorAtribuido")

  @@map("usuarios")
}

model Pessoa {
  id        String        @id @default(cuid())
  nome      String
  email     String?
  telefone  String?
  cpfCnpj   String?
  papeis    PapelPessoa[]
  origem    OrigemLead?
  estagioFunil EstagioFunil @default(NOVO_LEAD)
  observacoes String?
  criadoEm  DateTime      @default(now())
  atualizadoEm DateTime   @updatedAt

  corretorAtribuidoId String?
  corretorAtribuido   Usuario? @relation("CorretorAtribuido", fields: [corretorAtribuidoId], references: [id])

  imoveisComoProprietario Imovel[]      @relation("Proprietario")
  interacoes              Interacao[]
  negociosComoCliente     NegocioPessoa[]

  @@map("pessoas")
}

model Imovel {
  id           String           @id @default(cuid())
  codigo       Int              @unique @default(autoincrement())
  titulo       String
  descricao    String?
  tipo         String
  finalidade   FinalidadeImovel
  status       StatusImovel     @default(RASCUNHO)
  lancamento   Boolean          @default(false)
  destaque     Boolean          @default(false)
  oportunidade Boolean          @default(false)
  slideshow    Boolean          @default(false)
  estagioObra      EstagioObra?
  previsaoEntrega  DateTime?
  construtora      String?

  // Endereço
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String
  cidade       String
  estado       String
  latitude     Float?
  longitude    Float?

  // Valores
  preco        Decimal?  @db.Decimal(14, 2)
  precoAluguel Decimal?  @db.Decimal(14, 2)
  precoCondominio Decimal? @db.Decimal(14, 2)
  precoIptu    Decimal?  @db.Decimal(14, 2)

  // Características
  areaTotal    Float?
  areaPrivativa Float?
  quartos      Int?
  suites       Int?
  banheiros    Int?
  vagasGaragem Int?
  caracteristicasImovel     String[] @default([])
  caracteristicasCondominio String[] @default([])

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  publicadoEm  DateTime?

  corretorResponsavelId String?
  corretorResponsavel   Usuario? @relation("CorretorResponsavel", fields: [corretorResponsavelId], references: [id])

  proprietarioId String?
  proprietario   Pessoa? @relation("Proprietario", fields: [proprietarioId], references: [id])

  midias           Midia[]
  historicoStatus  HistoricoStatusImovel[]
  interacoes       Interacao[]
  negocios         Negocio[]
  publicacoesPortais PublicacaoPortal[]

  @@index([status])
  @@index([cidade, bairro])
  @@index([finalidade, tipo])
  @@index([lancamento])
  @@map("imoveis")
}

model Midia {
  id        String    @id @default(cuid())
  imovelId  String
  imovel    Imovel    @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  tipo      TipoMidia
  url       String
  ehCapa    Boolean   @default(false)
  ordem     Int       @default(0)

  criadoEm  DateTime  @default(now())

  @@index([imovelId])
  @@map("midias")
}

model HistoricoStatusImovel {
  id         String       @id @default(cuid())
  imovelId   String
  imovel     Imovel       @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  statusAnterior StatusImovel?
  statusNovo StatusImovel
  alteradoEm DateTime     @default(now())

  @@index([imovelId])
  @@map("historico_status_imoveis")
}

model Interacao {
  id         String        @id @default(cuid())
  pessoaId   String
  pessoa     Pessoa        @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  imovelId   String?
  imovel     Imovel?       @relation(fields: [imovelId], references: [id])
  corretorId String?
  corretor   Usuario?      @relation(fields: [corretorId], references: [id])

  tipo       TipoInteracao
  notas      String?
  dataHora   DateTime      @default(now())

  @@index([pessoaId])
  @@map("interacoes")
}

model Negocio {
  id         String      @id @default(cuid())
  imovelId   String
  imovel     Imovel      @relation(fields: [imovelId], references: [id])
  corretorId String?
  corretor   Usuario?    @relation(fields: [corretorId], references: [id])

  tipo       TipoNegocio
  valorFinal Decimal     @db.Decimal(14, 2)
  comissao   Decimal?    @db.Decimal(14, 2)
  fechadoEm  DateTime    @default(now())

  pessoas    NegocioPessoa[]

  @@index([imovelId])
  @@map("negocios")
}

model NegocioPessoa {
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  pessoaId  String
  pessoa    Pessoa  @relation(fields: [pessoaId], references: [id])

  @@id([negocioId, pessoaId])
  @@map("negocios_pessoas")
}

// Registro de envio/sincronização de um imóvel para um portal externo (ZAP, VivaReal, OLX, Imovelweb, Mercado Livre).
model PublicacaoPortal {
  id           String   @id @default(cuid())
  imovelId     String
  imovel       Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  portal       String
  idAnuncioExterno String?
  ultimaSincronizacaoEm DateTime?
  ultimoErro   String?

  @@unique([imovelId, portal])
  @@map("publicacoes_portais")
}

// Catálogo de opções selecionáveis para as características do imóvel/condomínio (gerenciado em /admin/caracteristicas).
model CaracteristicaOpcao {
  id        String                  @id @default(cuid())
  nome      String
  categoria CategoriaCaracteristica
  criadoEm  DateTime                @default(now())

  @@unique([categoria, nome])
  @@map("caracteristicas_opcoes")
}

// Catálogo de tipos de imóvel selecionáveis, residencial/comercial (gerenciado em /admin/tipos-imovel).
model TipoImovelOpcao {
  id        String              @id @default(cuid())
  nome      String
  categoria CategoriaTipoImovel
  criadoEm  DateTime            @default(now())

  @@unique([categoria, nome])
  @@map("tipos_imovel_opcoes")
}

// Registro único com os dados de contato/redes sociais da imobiliária (gerenciado em /admin/configuracoes).
model ConfiguracaoContato {
  id                  String   @id @default("singleton")
  telefone            String?
  email               String?
  whatsapp            String?
  instagram           String?
  facebook            String?
  youtube             String?
  linkedin            String?
  codigoImovelPrefixo String?
  logo                String?
  logoAltura          Int?
  atualizadoEm        DateTime @updatedAt

  @@map("configuracao_contato")
}

// =====================================================================
// Fundação multi-tenant (EasyMob) — ver /Users/alexboccia/.claude/plans/
// glittery-noodling-harp.md para o plano completo.
//
// FASE 1: modelos novos, aditivos, ainda não usados pelo código da
// aplicação. Os modelos acima (Usuario, Imovel, Pessoa, etc.) continuam
// sendo a fonte de verdade até a Fase 2 (rename + corte de escopo).
// =====================================================================

// ---------- Tenancy & RBAC ----------

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  BROKER
  ASSISTANT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMember[]

  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  notificationPreferences NotificationPreference[]

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Organization {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  customDomain   String?  @unique
  planId         String
  plan           Plan     @relation(fields: [planId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members       OrganizationMember[]
  settings      OrganizationSettings?
  subscriptions Subscription[]
  invoices      Invoice[]
  billingEvents BillingEvent[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  aiUsages      AiUsage[]

  @@map("organizations")
}

model OrganizationSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  phone              String?
  email              String?
  whatsapp           String?
  instagram          String?
  facebook           String?
  youtube            String?
  linkedin           String?
  propertyCodePrefix String?
  logoUrl            String?
  logoHeight         Int?
  updatedAt          DateTime     @updatedAt

  @@map("organization_settings")
}

// ---------- Permissões (RBAC preparado, não hardcoded) ----------

model Permission {
  id          String @id @default(cuid())
  code        String @unique // "properties.create", "crm.view", "billing.manage"...
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(cuid())
  role         OrganizationRole
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ---------- Planos & Entitlements ----------

model Module {
  id          String  @id @default(cuid())
  code        String  @unique // "core","crm","properties","ia","portais","whatsapp","email"...
  name        String
  description String?
  active      Boolean @default(true)

  planModules PlanModule[]

  @@map("modules")
}

model Plan {
  id                String  @id @default(cuid())
  code              String  @unique // "BASICO" | "PRO" | "PREMIUM"
  name              String
  priceMonthlyCents Int?
  active            Boolean @default(true)

  organizations Organization[]
  planModules   PlanModule[]
  planLimits    PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanModule {
  id       String  @id @default(cuid())
  planId   String
  plan     Plan    @relation(fields: [planId], references: [id])
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id])
  enabled  Boolean @default(true)
  config   Json?

  @@unique([planId, moduleId])
  @@map("plan_modules")
}

model PlanLimit {
  id      String @id @default(cuid())
  planId  String
  plan    Plan   @relation(fields: [planId], references: [id])
  feature String // "PROPERTIES","USERS","PHOTOS","VIDEOS","IA_CREDITS"... string livre, não enum
  limit   Int?   // null = ilimitado

  @@unique([planId, feature])
  @@map("plan_limits")
}

// ---------- Billing (modelagem, zero lógica de cobrança) ----------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  externalId         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  status         InvoiceStatus
  amountCents    Int
  currency       String        @default("BRL")
  dueDate        DateTime?
  paidAt         DateTime?
  externalId     String?
  createdAt      DateTime      @default(now())

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amountCents Int
  method      String?
  status      PaymentStatus
  externalId  String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@map("payments")
}

model BillingEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  payload        Json?
  createdAt      DateTime     @default(now())

  @@map("billing_events")
}

// ---------- Auditoria ----------

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  entity         String
  entityId       String?
  action         String
  payload        Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
  @@map("activity_logs")
}

// ---------- Notificações (arquitetura, sem envio implementado) ----------

model NotificationChannel {
  id   String @id @default(cuid())
  code String @unique // "EMAIL","PUSH","WHATSAPP","SMS"
  name String

  preferences NotificationPreference[]

  @@map("notification_channels")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  type           String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@map("notifications")
}

model NotificationPreference {
  id                   String               @id @default(cuid())
  organizationMemberId String
  organizationMember   OrganizationMember   @relation(fields: [organizationMemberId], references: [id])
  channelId            String
  channel              NotificationChannel  @relation(fields: [channelId], references: [id])
  notificationType     String
  enabled              Boolean              @default(true)

  @@unique([organizationMemberId, channelId, notificationType])
  @@map("notification_preferences")
}

// ---------- Uso de IA ----------

model AiUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  provider       String
  model          String
  feature        String
  tokensInput    Int
  tokensOutput   Int
  costCents      Int?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("ai_usages")
}

// ---------- Plataforma (super-admin — schema preparado, nada implementado) ----------

enum PlatformRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

model PlatformOperator {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("platform_operators")
}
