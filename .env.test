# Ambiente de TESTE — carregado automaticamente pelo Next.js quando
# NODE_ENV=test (E2E) e manualmente por vitest.setup.ts (unit/integração).
# Sem segredo real: banco local do Docker Compose, valores fixos.
# NUNCA aponte isto para o banco de produção (Neon) ou de desenvolvimento.

# Nome do banco termina em "_test" de propósito — vitest.setup.ts recusa
# rodar se não terminar assim (proteção contra rodar teste em cima de
# dev/produção por engano). Criado/migrado por scripts/prepare-test-db.ts
# (roda sozinho antes de "npm run test" e "npm run test:e2e").
DATABASE_URL="postgresql://imoveis:imoveis@localhost:5432/imoveis_test?schema=public"

AUTH_SECRET="valor-fixo-so-para-testes-nunca-use-isso-em-producao"

# Organização usada pelos testes de integração/E2E que passam por
# getPublicOrganizationId() (formulário público, header do site).
ORG_SLUG="e2e-org-a"
ORG_NAME="Organização E2E A"
PUBLIC_ORG_SLUG="e2e-org-a"

SEED_ADMIN_EMAIL="owner-a@e2e.test"
SEED_ADMIN_SENHA="senha-e2e-teste-123"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_NOME_IMOBILIARIA="Imobiliária de Teste"
NEXT_PUBLIC_WHATSAPP_NUMERO="5511999990000"
NEXT_PUBLIC_EMAIL_CONTATO="contato@e2e.test"

# R2/Resend/Upstash deliberadamente vazios: nenhum teste desta fase bate
# num serviço externo real. Upload é testado pela validação (magic bytes/
# extensão/tamanho) sem precisar enviar pro R2 de verdade; e-mail não é
# testado; rate limiting usa o mesmo fake de KvStore dos testes unitários
# (ver tests/integration/rate-limiting.integration.test.ts) em vez de um
# Redis real.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Teste <contato@e2e.test>"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
