# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# .env.test é intencionalmente commitado — convenção documentada do
# próprio Next.js (node_modules/next/dist/docs/.../environment-variables.md):
# sem segredo real, só credenciais do Postgres local de teste e valores
# fixos, pra todo mundo (e o CI) rodar os testes com o mesmo ambiente.
!.env.test

# playwright
/test-results
/playwright-report
/playwright/.cache

# vercel
.vercel

# sentry — .env.sentry-build-plugin já cai no padrão .env* acima;
# .sentryclirc é o formato antigo (sentry-cli local), nunca deve ter token
# de verdade commitado se alguém criar um pra testar upload de source map
# manualmente.
.sentryclirc

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
